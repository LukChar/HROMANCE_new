@page "/verwaltung"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Disponent")]

@using HRomance.Services

@inject MitarbeiterService MitarbeiterService
@inject KundeService KundeService
@inject AuftragService AuftragService

<PageTitle>Dashboard</PageTitle>

<div class="dashboard">

    <div class="dashboard-header">
        <div>
            <h1>Dashboard</h1>
            <p>Übersicht über Mitarbeiter, Kunden und Aufträge</p>
        </div>
    </div>

    <div class="dashboard-cards">

        <div class="dashboard-card">
            <p>Mitarbeiter</p>
            <h2>@anzahlMitarbeiter</h2>
            <span>Gesamt</span>
        </div>

        <div class="dashboard-card">
            <p>Verfügbare Mitarbeiter</p>
            <h2>@anzahlVerfuegbareMitarbeiter</h2>
            <span>Aktuell verfügbar</span>
        </div>

        <div class="dashboard-card">
            <p>Offene Aufträge</p>
            <h2>@anzahlOffeneAuftraege</h2>
            <span>Noch nicht besetzt</span>
        </div>

        <div class="dashboard-card">
            <p>Kunden</p>
            <h2>@anzahlKunden</h2>
            <span>Gesamt</span>
        </div>

    </div>

    <div class="dashboard-content">

        <div class="dashboard-section">

            <div class="section-header">
                <h2>Offene Aufträge</h2>
            </div>

            @if (offeneAuftraege.Count == 0)
            {
                <div class="empty-message">
                    Zurzeit sind keine offenen Aufträge vorhanden.
                </div>
            }
            else
            {
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Auftrag</th>
                                <th>Kunde</th>
                                <th>Einsatzort</th>
                                <th>Zeitraum</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var auftrag in offeneAuftraege)
                            {
                                <tr>
                                    <td>@auftrag.Titel</td>
                                    <td>@auftrag.Kunde?.Firmenname</td>
                                    <td>@auftrag.Einsatzort</td>
                                    <td>
                                        @auftrag.Startdatum.ToString("dd.MM.yyyy")
                                        -
                                        @auftrag.Enddatum.ToString("dd.MM.yyyy")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>

        <div class="dashboard-section">

            <div class="section-header">
                <h2>Verfügbare Mitarbeiter</h2>
            </div>

            @if (verfuegbareMitarbeiter.Count == 0)
            {
                <div class="empty-message">
                    Zurzeit sind keine Mitarbeiter verfügbar.
                </div>
            }
            else
            {
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Personalnummer</th>
                                <th>Qualifikation</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var mitarbeiter in verfuegbareMitarbeiter)
                            {
                                <tr>
                                    <td>@mitarbeiter.Vorname @mitarbeiter.Nachname</td>
                                    <td>@mitarbeiter.Personalnummer</td>
                                    <td>@mitarbeiter.Qualifikation</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>

    </div>

</div>

@code {
    private int anzahlMitarbeiter = 0;
    private int anzahlKunden = 0;
    private int anzahlOffeneAuftraege = 0;
    private int anzahlVerfuegbareMitarbeiter = 0;

    private List<HRomance.Models.Auftrag> offeneAuftraege = new List<HRomance.Models.Auftrag>();
    private List<HRomance.Models.Mitarbeiter> verfuegbareMitarbeiter = new List<HRomance.Models.Mitarbeiter>();

    protected override async Task OnInitializedAsync()
    {
        var mitarbeiterListe = await MitarbeiterService.GetAllAsync();
        var kundenListe = await KundeService.GetAllAsync();
        var auftragListe = await AuftragService.GetAllAsync();

        anzahlMitarbeiter = mitarbeiterListe.Count;
        anzahlKunden = kundenListe.Count;

        foreach (var mitarbeiter in mitarbeiterListe)
        {
            if (mitarbeiter.Verfuegbar == true)
            {
                anzahlVerfuegbareMitarbeiter++;
                verfuegbareMitarbeiter.Add(mitarbeiter);
            }
        }

        foreach (var auftrag in auftragListe)
        {
            if (auftrag.Besetzt == false)
            {
                anzahlOffeneAuftraege++;
                offeneAuftraege.Add(auftrag);
            }
        }
    }
}
