@page "/kunden/details/{Id:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Disponent")]
@rendermode InteractiveServer

@using HRomance.Models
@using HRomance.Services

@inject KundeService KundeService
@inject NavigationManager Navigation

<PageTitle>Kundendetails</PageTitle>

<div class="details-page">
    <div class="page-header">
        <div>
            <h1>Kundendetails</h1>
            <p>Informationen zum Kunden</p>
        </div>

        <a href="/kunden" class="back-button">Zurück</a>
    </div>

    @if (!istGeladen)
    {
        <p>Lade Daten...</p>
    }
    else if (kunde == null)
    {
        <div class="message-card">
            Kunde wurde nicht gefunden.
        </div>
    }
    else
    {
        <div class="details-card">
            <div class="details-grid">
                <div>
                    <span class="details-label">Firmenname</span>
                    <strong>@kunde.Firmenname</strong>
                </div>

                <div>
                    <span class="details-label">Ansprechpartner</span>
                    <strong>@kunde.Ansprechpartner</strong>
                </div>

                <div>
                    <span class="details-label">E-Mail</span>
                    <strong>@kunde.Email</strong>
                </div>

                <div>
                    <span class="details-label">Telefon</span>
                    <strong>@kunde.Telefon</strong>
                </div>
            </div>

            <div class="details-actions">
                <a href="/kunden/edit/@kunde.Id" class="edit-button">Bearbeiten</a>

                <button type="button"
                        class="delete-button"
                        @onclick="LoeschenBestaetigen">
                    Löschen
                </button>
            </div>

            @if (loeschenBestaetigen)
            {
                <div class="delete-confirmation">
                    <p>Möchtest du diesen Kunden wirklich löschen?</p>

                    <div class="confirmation-actions">
                        <button type="button"
                                class="cancel-button"
                                @onclick="LoeschenAbbrechen">
                            Abbrechen
                        </button>

                        <button type="button"
                                class="delete-button"
                                @onclick="EndgueltigLoeschen">
                            Endgültig löschen
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Kunde? kunde;
    private bool istGeladen;
    private bool loeschenBestaetigen;

    protected override async Task OnInitializedAsync()
    {
        kunde = await KundeService.GetByIdAsync(Id);
        istGeladen = true;
    }

    private void LoeschenBestaetigen()
    {
        loeschenBestaetigen = true;
    }

    private void LoeschenAbbrechen()
    {
        loeschenBestaetigen = false;
    }

    private async Task EndgueltigLoeschen()
    {
        await KundeService.DeleteAsync(Id);
        Navigation.NavigateTo("/kunden");
    }
}
