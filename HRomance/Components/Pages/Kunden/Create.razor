@page "/kunden/create"
@rendermode InteractiveServer

@using HRomance.Models
@using HRomance.Services

@inject KundeService KundeService
@inject NavigationManager Navigation

<PageTitle>Kunde hinzufügen</PageTitle>

<div class="create-page">
    <div class="page-header">
        <div>
            <h1>Kunde hinzufügen</h1>
            <p>Neuen Kunden anlegen</p>
        </div>

        <a href="/kunden" class="back-button">Zurück</a>
    </div>

    <div class="form-card">
        <EditForm Model="kunde"
                  OnValidSubmit="Speichern"
                  FormName="KundeErstellen">
            <DataAnnotationsValidator />

            <div class="form-grid">
                <div class="form-group">
                    <label>Firmenname</label>
                    <InputText class="form-input" @bind-Value="kunde.Firmenname" />
                    <ValidationMessage For="@(() => kunde.Firmenname)" />
                </div>

                <div class="form-group">
                    <label>Ansprechpartner</label>
                    <InputText class="form-input" @bind-Value="kunde.Ansprechpartner" />
                </div>

                <div class="form-group">
                    <label>E-Mail</label>
                    <InputText class="form-input" @bind-Value="kunde.Email" />
                </div>

                <div class="form-group">
                    <label>Telefon</label>
                    <InputText class="form-input" @bind-Value="kunde.Telefon" />
                </div>
            </div>

            <div class="form-actions">
                <button type="button"
                        class="cancel-button"
                        @onclick="Abbrechen">
                    Abbrechen
                </button>

                <button type="submit" class="save-button">
                    Speichern
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private Kunde kunde = new Kunde();

    private async Task Speichern()
    {
        await KundeService.AddAsync(kunde);
        Navigation.NavigateTo("/kunden");
    }

    private void Abbrechen()
    {
        Navigation.NavigateTo("/kunden");
    }
}
