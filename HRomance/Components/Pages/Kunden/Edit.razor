@page "/kunden/edit/{Id:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Disponent")]
@rendermode InteractiveServer

@using HRomance.Models
@using HRomance.Services

@inject KundeService KundeService
@inject NavigationManager Navigation

<PageTitle>Kunde bearbeiten</PageTitle>

<div class="edit-page">
    <div class="page-header">
        <div>
            <h1>Kunde bearbeiten</h1>
            <p>Kundendaten aktualisieren</p>
        </div>

        <a href="/kunden/details/@Id" class="back-button">Zurück</a>
    </div>

    @if (!istGeladen)
    {
        <p>Lade Daten...</p>
    }
    else if (kunde == null)
    {
        <div class="message-card">
            Kunde wurde nicht gefunden.
        </div>
    }
    else
    {
        <div class="form-card">
            <EditForm Model="kunde"
                      OnValidSubmit="Speichern"
                      FormName="KundeBearbeiten">
                <DataAnnotationsValidator />

                <div class="form-grid">
                    <div class="form-group">
                        <label>Firmenname</label>
                        <InputText class="form-input" @bind-Value="kunde.Firmenname" />
                        <ValidationMessage For="@(() => kunde.Firmenname)" />
                    </div>

                    <div class="form-group">
                        <label>Ansprechpartner</label>
                        <InputText class="form-input" @bind-Value="kunde.Ansprechpartner" />
                    </div>

                    <div class="form-group">
                        <label>E-Mail</label>
                        <InputText class="form-input" @bind-Value="kunde.Email" />
                    </div>

                    <div class="form-group">
                        <label>Telefon</label>
                        <InputText class="form-input" @bind-Value="kunde.Telefon" />
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button"
                            class="cancel-button"
                            @onclick="Abbrechen">
                        Abbrechen
                    </button>

                    <button type="submit" class="save-button">
                        Änderungen speichern
                    </button>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Kunde? kunde;
    private bool istGeladen;

    protected override async Task OnInitializedAsync()
    {
        var geladenerKunde = await KundeService.GetByIdAsync(Id);

        if (geladenerKunde != null)
        {
            kunde = new Kunde
            {
                Id = geladenerKunde.Id,
                Firmenname = geladenerKunde.Firmenname,
                Ansprechpartner = geladenerKunde.Ansprechpartner,
                Email = geladenerKunde.Email,
                Telefon = geladenerKunde.Telefon
            };
        }

        istGeladen = true;
    }

    private async Task Speichern()
    {
        if (kunde != null)
        {
            await KundeService.UpdateAsync(kunde);
            Navigation.NavigateTo($"/kunden/details/{kunde.Id}");
        }
    }

    private void Abbrechen()
    {
        Navigation.NavigateTo($"/kunden/details/{Id}");
    }
}
