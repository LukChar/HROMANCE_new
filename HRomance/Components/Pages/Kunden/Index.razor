@page "/kunden"
@rendermode InteractiveServer

@using HRomance.Models
@using HRomance.Services

@inject KundeService KundeService

<PageTitle>Kunden</PageTitle>

<div class="kunden-page">
    <div class="page-header">
        <div>
            <h1>Kunden</h1>
            <p>Übersicht über alle Kunden</p>
        </div>

        <a href="/kunden/create" class="add-button">
            Kunde hinzufügen
        </a>
    </div>

    <div class="overview">
        <div>
            <span class="overview-label">Kunden gesamt</span>
            <strong>@kundenListe.Count</strong>
        </div>
    </div>

    <div class="kunden-list">
        <div class="list-header">
            <h2>Alle Kunden</h2>
        </div>

        <div class="search-area">
            <label for="kundensuche">Suche</label>
            <input id="kundensuche"
                   class="search-input"
                   type="text"
                   value="@suchtext"
                   @oninput="SucheGeaendert" />
        </div>

        @if (kundenListe.Count == 0)
        {
            <div class="empty-message">
                Es sind noch keine Kunden vorhanden.
            </div>
        }
        else if (gefilterteKunden.Count == 0)
        {
            <div class="empty-message">
                Keine Kunden gefunden.
            </div>
        }
        else
        {
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Firmenname</th>
                            <th>Ansprechpartner</th>
                            <th>E-Mail</th>
                            <th>Telefon</th>
                            <th>Aktionen</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var kunde in gefilterteKunden)
                        {
                            <tr>
                                <td>@kunde.Firmenname</td>
                                <td>@kunde.Ansprechpartner</td>
                                <td>@kunde.Email</td>
                                <td>@kunde.Telefon</td>
                                <td>
                                    <a href="/kunden/details/@kunde.Id" class="details-button">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<Kunde> kundenListe = new List<Kunde>();
    private List<Kunde> gefilterteKunden = new List<Kunde>();
    private string suchtext = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        kundenListe = await KundeService.GetAllAsync();
        SucheAnwenden();
    }

    private void SucheGeaendert(ChangeEventArgs e)
    {
        suchtext = e.Value?.ToString() ?? string.Empty;
        SucheAnwenden();
    }

    private void SucheAnwenden()
    {
        gefilterteKunden.Clear();

        foreach (var kunde in kundenListe)
        {
            bool passtZurSuche =
                kunde.Firmenname.Contains(suchtext, StringComparison.OrdinalIgnoreCase) ||
                kunde.Ansprechpartner.Contains(suchtext, StringComparison.OrdinalIgnoreCase) ||
                kunde.Email.Contains(suchtext, StringComparison.OrdinalIgnoreCase);

            if (passtZurSuche)
            {
                gefilterteKunden.Add(kunde);
            }
        }
    }
}
