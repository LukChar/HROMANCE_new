@page "/kunden"
@rendermode InteractiveServer

@using HRomance.Models
@using HRomance.Services

@inject KundeService KundeService
@inject NavigationManager Navigation

<PageTitle>Kunden</PageTitle>

<h3>Kundenverwaltung</h3>

<button class="btn btn-primary mb-3" @onclick="NeuerKunde">
    Neuer Kunde
</button>

<div class="mb-3">
    <InputText class="form-control"
               @bind-Value="suchbegriff"
               placeholder="Nach Firmenname oder Ansprechpartner suchen..." />
</div>

@if (!kundenListe.Any())
{
    <div class="alert alert-info">
        Es sind keine Kunden vorhanden.
    </div>
}
else
{
    <table class="table table-striped table-hover">

        <thead>
            <tr>
                <th>Aktionen</th>
                <th>Firmenname</th>
                <th>Ansprechpartner</th>
                <th>E-Mail</th>
                <th>Telefon</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var kunde in kundenListe.Where(k =>
                string.IsNullOrWhiteSpace(suchbegriff)
                || k.Firmenname.Contains(suchbegriff, StringComparison.OrdinalIgnoreCase)
                || k.Ansprechpartner.Contains(suchbegriff, StringComparison.OrdinalIgnoreCase)))
            {
                <tr>

                    <td>
                        <button class="btn btn-details btn-sm me-2"
                                @onclick="() => Details(kunde.Id)">
                            Details
                        </button>

                        <button class="btn btn-bearbeiten btn-sm me-2"
                                @onclick="() => Bearbeiten(kunde.Id)">
                            Bearbeiten
                        </button>

                        <button class="btn btn-loeschen btn-sm"
                                @onclick="() => Loeschen(kunde.Id)">
                            Löschen
                        </button>
                    </td>

                    <td>@kunde.Firmenname</td>
                    <td>@kunde.Ansprechpartner</td>
                    <td>@kunde.Email</td>
                    <td>@kunde.Telefon</td>

                </tr>
            }

        </tbody>

    </table>
}

@code {

    private List<Kunde> kundenListe = new();

    private string suchbegriff = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        kundenListe = await KundeService.GetAllAsync();
    }

    private void NeuerKunde()
    {
        Navigation.NavigateTo("/kunden/create");
    }

    private void Bearbeiten(int id)
    {
        Navigation.NavigateTo($"/kunden/edit/{id}");
    }

    private void Details(int id)
    {
        Navigation.NavigateTo($"/kunden/details/{id}");
    }

    private async Task Loeschen(int id)
    {
        await KundeService.DeleteAsync(id);

        kundenListe = await KundeService.GetAllAsync();
    }

}