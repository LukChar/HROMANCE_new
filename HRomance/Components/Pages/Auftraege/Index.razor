@page "/auftraege"
@rendermode InteractiveServer

@using HRomance.Models
@using HRomance.Services

@inject AuftragService AuftragService
@inject NavigationManager Navigation

<PageTitle>Aufträge</PageTitle>

<h3>Auftragsverwaltung</h3>

<button class="btn btn-primary mb-3" @onclick="NeuerAuftrag">
    Neuer Auftrag
</button>

<div class="mb-3">
    <InputText class="form-control"
               @bind-Value="suchbegriff"
               placeholder="Nach Titel, Einsatzort oder Qualifikation suchen..." />
</div>

@if (!auftraegeListe.Any())
{
    <div class="alert alert-info">
        Es sind keine Aufträge vorhanden.
    </div>
}
else
{
    <table class="table table-striped table-hover">

        <thead>
            <tr>
                <th>Aktionen</th>
                <th>Titel</th>
                <th>Kunde</th>
                <th>Einsatzort</th>
                <th>Qualifikation</th>
                <th>Startdatum</th>
                <th>Enddatum</th>
                <th>Besetzt</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var auftrag in auftraegeListe.Where(a =>
                string.IsNullOrWhiteSpace(suchbegriff)
                || a.Titel.Contains(suchbegriff, StringComparison.OrdinalIgnoreCase)
                || a.Einsatzort.Contains(suchbegriff, StringComparison.OrdinalIgnoreCase)
                || a.BenoetigteQualifikation.Contains(suchbegriff, StringComparison.OrdinalIgnoreCase)))
            {
                <tr>

                    <td>
                        <button class="btn btn-details btn-sm me-2"
                                @onclick="() => Details(auftrag.Id)">
                            Details
                        </button>

                        <button class="btn btn-bearbeiten btn-sm me-2"
                                @onclick="() => Bearbeiten(auftrag.Id)">
                            Bearbeiten
                        </button>

                        <button class="btn btn-loeschen btn-sm"
                                @onclick="() => Loeschen(auftrag.Id)">
                            Löschen
                        </button>
                    </td>

                    <td>@auftrag.Titel</td>
                    <td>@auftrag.Kunde?.Firmenname</td>
                    <td>@auftrag.Einsatzort</td>
                    <td>@auftrag.BenoetigteQualifikation</td>
                    <td>@auftrag.Startdatum.ToShortDateString()</td>
                    <td>@auftrag.Enddatum.ToShortDateString()</td>
                    <td>@(auftrag.Besetzt ? "Ja" : "Nein")</td>

                </tr>
            }

        </tbody>

    </table>
}

@code {

    private List<Auftrag> auftraegeListe = new();

    private string suchbegriff = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        auftraegeListe = await AuftragService.GetAllAsync();
    }

    private void NeuerAuftrag()
    {
        Navigation.NavigateTo("/auftraege/create");
    }

    private void Bearbeiten(int id)
    {
        Navigation.NavigateTo($"/auftraege/edit/{id}");
    }

    private void Details(int id)
    {
        Navigation.NavigateTo($"/auftraege/details/{id}");
    }

    private async Task Loeschen(int id)
    {
        await AuftragService.DeleteAsync(id);

        auftraegeListe = await AuftragService.GetAllAsync();
    }

}