@page "/auftraege"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Disponent")]
@rendermode InteractiveServer

@using HRomance.Models
@using HRomance.Services

@inject AuftragService AuftragService
@inject KundeService KundeService
@inject QualifikationService QualifikationService

<PageTitle>Aufträge</PageTitle>

<div class="auftraege-page">
    <div class="page-header">
        <div>
            <h1>Aufträge</h1>
            <p>Übersicht über alle Aufträge</p>
        </div>

        <div class="header-actions">
            <a href="/auftraege/kalender" class="calendar-button">
                Kalenderansicht
            </a>
            <button type="button" class="add-button" @onclick="NeuenAuftragOeffnen">
                Neuer Auftrag
            </button>
        </div>
    </div>

    <div class="overview">
        <div>
            <span class="overview-label">Aufträge gesamt</span>
            <strong>@auftraegeListe.Count</strong>
        </div>

        <div>
            <span class="overview-label">Offene Aufträge</span>
            <strong>@anzahlOffen</strong>
        </div>

        <div>
            <span class="overview-label">Besetzte Aufträge</span>
            <strong>@anzahlBesetzt</strong>
        </div>
    </div>

    <div class="auftraege-list">
        <div class="list-header">
            <h2>Alle Aufträge</h2>
        </div>

        <div class="filter-area">
            <div class="filter-group search-group">
                <label for="auftragssuche">Suche</label>
                <input id="auftragssuche"
                       class="filter-input"
                       type="text"
                       placeholder="Titel, Einsatzort oder Kunde suchen..."
                       value="@suchtext"
                       @oninput="SucheGeaendert" />
            </div>

            <div class="filter-group">
                <label for="statusfilter">Status</label>
                <select id="statusfilter"
                        class="filter-input"
                        value="@statusfilter"
                        @onchange="StatusGeaendert">
                    <option value="Alle">Alle</option>
                    <option value="Offen">Offen</option>
                    <option value="Besetzt">Besetzt</option>
                </select>
            </div>

            <div class="filter-group">
                <label for="kundenfilter">Kunde</label>
                <select id="kundenfilter"
                        class="filter-input"
                        value="@kundenfilter"
                        @onchange="KundeGeaendert">
                    <option value="0">Alle Kunden</option>
                    @foreach (var kunde in kundenListe)
                    {
                        <option value="@kunde.Id">@kunde.Firmenname</option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <label for="qualifikationsfilter">Qualifikation</label>
                <select id="qualifikationsfilter"
                        class="filter-input"
                        value="@qualifikationsfilter"
                        @onchange="QualifikationGeaendert">
                    <option value="">Alle Qualifikationen</option>
                    @foreach (var qualifikation in qualifikationen)
                    {
                        <option value="@qualifikation.Id">@qualifikation.Name</option>
                    }
                </select>
            </div>
        </div>

        @if (auftraegeListe.Count == 0)
        {
            <div class="empty-message">
                Es sind noch keine Aufträge vorhanden.
            </div>
        }
        else if (gefilterteAuftraege.Count == 0)
        {
            <div class="empty-message">
                Keine Aufträge gefunden.
            </div>
        }
        else
        {
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Titel</th>
                            <th>Kunde</th>
                            <th>Zeitraum</th>
                            <th>Benötigte Qualifikationen</th>
                            <th>Status</th>
                            <th>Zugewiesene Mitarbeiter</th>
                            <th>Aktionen</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var auftrag in gefilterteAuftraege)
                        {
                            <tr class="clickable-row" @onclick="() => AuftragOeffnen(auftrag)">
                                <td>@auftrag.Titel</td>
                                <td>@auftrag.Kunde?.Firmenname</td>
                                <td>@auftrag.Startdatum.ToShortDateString() bis @auftrag.Enddatum.ToShortDateString()</td>
                                <td>
                                    @if (auftrag.Qualifikationen.Count == 0)
                                    {
                                        <span>Keine</span>
                                    }
                                    else
                                    {
                                        @QualifikationsNamen(auftrag)
                                    }
                                </td>
                                <td>
                                    @if (IstBesetzt(auftrag))
                                    {
                                        <span class="status besetzt">Besetzt</span>
                                    }
                                    else
                                    {
                                        <span class="status offen">Offen</span>
                                    }
                                </td>
                                <td>@MitarbeiterNamen(auftrag)</td>
                                <td>
                                    <button type="button" class="details-button" @onclick="() => AuftragOeffnen(auftrag)" @onclick:stopPropagation="true">
                                        Details
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (ausgewaehlterAuftrag != null || neuerAuftragPopup)
{
    <AuftragPopup Auftrag="@ausgewaehlterAuftrag"
                   NeuerAuftrag="@neuerAuftragPopup"
                   Aktualisiert="DatenLaden"
                   Geschlossen="PopupSchliessen" />
}

@code {
    private List<Auftrag> auftraegeListe = new List<Auftrag>();
    private List<Auftrag> gefilterteAuftraege = new List<Auftrag>();
    private List<Kunde> kundenListe = new List<Kunde>();
    private List<Qualifikation> qualifikationen = new List<Qualifikation>();
    private int anzahlOffen;
    private int anzahlBesetzt;
    private string suchtext = string.Empty;
    private string statusfilter = "Alle";
    private int kundenfilter;
    private int qualifikationsfilter;
    private Auftrag? ausgewaehlterAuftrag;
    private bool neuerAuftragPopup;

    protected override async Task OnInitializedAsync()
    {
        await DatenLaden();
    }

    private async Task DatenLaden()
    {
        auftraegeListe = await AuftragService.GetAllAsync();
        kundenListe = await KundeService.GetAllAsync();
        qualifikationen = await QualifikationService.GetAllAsync();
        anzahlOffen = 0;
        anzahlBesetzt = 0;

        foreach (var auftrag in auftraegeListe)
        {
            if (IstBesetzt(auftrag))
            {
                anzahlBesetzt++;
            }
            else
            {
                anzahlOffen++;
            }

        }

        FilterAnwenden();
    }

    private void AuftragOeffnen(Auftrag auftrag)
    {
        ausgewaehlterAuftrag = auftrag;
        neuerAuftragPopup = false;
    }

    private void NeuenAuftragOeffnen()
    {
        ausgewaehlterAuftrag = null;
        neuerAuftragPopup = true;
    }

    private void PopupSchliessen()
    {
        ausgewaehlterAuftrag = null;
        neuerAuftragPopup = false;
    }

    private void SucheGeaendert(ChangeEventArgs e)
    {
        suchtext = e.Value?.ToString() ?? string.Empty;
        FilterAnwenden();
    }

    private void StatusGeaendert(ChangeEventArgs e)
    {
        statusfilter = e.Value?.ToString() ?? "Alle";
        FilterAnwenden();
    }

    private void KundeGeaendert(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out kundenfilter);
        FilterAnwenden();
    }

    private void QualifikationGeaendert(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out qualifikationsfilter);
        FilterAnwenden();
    }

    private string QualifikationsNamen(Auftrag auftrag)
    {
        string namen = string.Empty;

        foreach (var qualifikation in auftrag.Qualifikationen)
        {
            if (namen != string.Empty)
            {
                namen += ", ";
            }

            namen += qualifikation.Name;
        }

        return namen;
    }

    private bool IstBesetzt(Auftrag auftrag)
    {
        return auftrag.Mitarbeiter.Count > 0;
    }

    private string MitarbeiterNamen(Auftrag auftrag)
    {
        var namen = string.Empty;

        foreach (var mitarbeiter in auftrag.Mitarbeiter)
        {
            if (namen != string.Empty)
            {
                namen += ", ";
            }

            namen += mitarbeiter.Vorname + " " + mitarbeiter.Nachname;
        }

        if (namen == string.Empty)
        {
            return "-";
        }

        return namen;
    }

    private void FilterAnwenden()
    {
        gefilterteAuftraege.Clear();

        foreach (var auftrag in auftraegeListe)
        {
            bool passtZurSuche =
                auftrag.Titel.Contains(suchtext, StringComparison.OrdinalIgnoreCase) ||
                auftrag.Einsatzort.Contains(suchtext, StringComparison.OrdinalIgnoreCase) ||
                (auftrag.Kunde?.Firmenname.Contains(
                    suchtext,
                    StringComparison.OrdinalIgnoreCase) == true) ||
                (auftrag.Kunde?.Ansprechpartner.Contains(
                    suchtext,
                    StringComparison.OrdinalIgnoreCase) == true);

            bool passtZumStatus = true;

            if (statusfilter == "Offen" && IstBesetzt(auftrag))
            {
                passtZumStatus = false;
            }

            if (statusfilter == "Besetzt" && !IstBesetzt(auftrag))
            {
                passtZumStatus = false;
            }

            bool passtZumKunden = kundenfilter == 0 || auftrag.KundeId == kundenfilter;

            bool passtZurQualifikation = qualifikationsfilter == 0;

            foreach (var qualifikation in auftrag.Qualifikationen)
            {
                if (qualifikation.Id == qualifikationsfilter)
                {
                    passtZurQualifikation = true;
                }
            }

            if (passtZurSuche &&
                passtZumStatus &&
                passtZumKunden &&
                passtZurQualifikation)
            {
                gefilterteAuftraege.Add(auftrag);
            }
        }
    }
}
