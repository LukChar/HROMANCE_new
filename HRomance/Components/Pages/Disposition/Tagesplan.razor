@page "/disposition/tagesplan"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Disponent")]
@rendermode InteractiveServer

@using System.Globalization
@using HRomance.Models
@using HRomance.Services
@using HRomance.Components.Pages.Auftraege

@inject AuftragService AuftragService

<PageTitle>Disposition – Tag</PageTitle>

<div class="day-page">
    <div class="page-header">
        <div>
            <h1>Disposition</h1>
            <p>Tagesplanung der Aufträge</p>
        </div>

        <div class="view-switch">
            <a href="/disposition/tagesplan" class="active-view">Tag</a>
            <a href="/disposition">Woche</a>
            <a href="/disposition/monatsplan">Monat</a>
        </div>
    </div>

    <div class="day-navigation">
        <button type="button" @onclick="VorherigerTag">Zurück</button>
        <strong>@Tagesueberschrift()</strong>
        <button type="button" @onclick="NaechsterTag">Weiter</button>
        <button type="button" @onclick="Heute">Heute</button>
    </div>

    <div class="day-plan">
        @if (AuftraegeAmTag().Count == 0)
        {
            <p class="empty-message">Keine Aufträge an diesem Tag.</p>
        }
        else
        {
            <div class="order-list">
                @foreach (var auftrag in AuftraegeAmTag())
                {
                    <button type="button" class="order-card" @onclick="() => AuftragOeffnen(auftrag)">
                        <strong>@auftrag.Titel</strong>
                        <span>@(auftrag.Kunde?.Firmenname ?? "Kein Kunde")</span>
                        <span>@auftrag.Einsatzort</span>
                        <span>@auftrag.Startdatum.ToString("dd.MM.") - @auftrag.Enddatum.ToString("dd.MM.yyyy")</span>
                        <span class="@(auftrag.Mitarbeiter.Count > 0 ? "occupied" : "open")">
                            @(auftrag.Mitarbeiter.Count > 0 ? "Besetzt" : "Offen")@MitarbeiterText(auftrag)
                        </span>
                    </button>
                }
            </div>
        }
    </div>
</div>

@if (ausgewaehlterAuftrag != null)
{
    <AuftragPopup Auftrag="@ausgewaehlterAuftrag"
                   Aktualisiert="DatenLaden"
                   Geschlossen="PopupSchliessen" />
}

@code {
    private List<Auftrag> auftraege = new();
    private DateTime ausgewaehlterTag = DateTime.Today;
    private Auftrag? ausgewaehlterAuftrag;

    protected override async Task OnInitializedAsync()
    {
        await DatenLaden();
    }

    private async Task DatenLaden()
    {
        auftraege = await AuftragService.GetAllAsync();
    }

    private List<Auftrag> AuftraegeAmTag()
    {
        var passendeAuftraege = new List<Auftrag>();

        foreach (var auftrag in auftraege)
        {
            if (ausgewaehlterTag.Date >= auftrag.Startdatum.Date
                && ausgewaehlterTag.Date <= auftrag.Enddatum.Date)
            {
                passendeAuftraege.Add(auftrag);
            }
        }

        return passendeAuftraege;
    }

    private void VorherigerTag()
    {
        ausgewaehlterTag = ausgewaehlterTag.AddDays(-1);
    }

    private void NaechsterTag()
    {
        ausgewaehlterTag = ausgewaehlterTag.AddDays(1);
    }

    private void Heute()
    {
        ausgewaehlterTag = DateTime.Today;
    }

    private string Tagesueberschrift()
    {
        return ausgewaehlterTag.ToString("dddd, dd.MM.yyyy", CultureInfo.GetCultureInfo("de-DE"));
    }

    private string MitarbeiterText(Auftrag auftrag)
    {
        var namen = string.Empty;

        foreach (var mitarbeiter in auftrag.Mitarbeiter)
        {
            if (namen != string.Empty)
            {
                namen += ", ";
            }

            namen += mitarbeiter.Vorname + " " + mitarbeiter.Nachname;
        }

        if (namen == string.Empty)
        {
            return string.Empty;
        }

        return " · " + namen;
    }

    private void AuftragOeffnen(Auftrag auftrag)
    {
        ausgewaehlterAuftrag = auftrag;
    }

    private void PopupSchliessen()
    {
        ausgewaehlterAuftrag = null;
    }
}
