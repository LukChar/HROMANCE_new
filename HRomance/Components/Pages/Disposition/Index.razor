@page "/disposition"
@rendermode InteractiveServer

@using HRomance.Models
@using HRomance.Services
@using HRomance.Components.Pages.Auftraege

@inject AuftragService AuftragService

<PageTitle>Disposition</PageTitle>

<div class="disposition-page">
    <div class="page-header">
        <div>
            <h1>Disposition</h1>
            <p>Wochenplanung der Aufträge</p>
        </div>

        <div class="view-switch">
            <a href="/disposition" class="active-view">Woche</a>
            <a href="/disposition/monatsplan">Monat</a>
        </div>
    </div>

    <div class="week-navigation">
        <button type="button" @onclick="VorherigeWoche">Zurück</button>
        <strong>@Wochenzeitraum()</strong>
        <button type="button" @onclick="NaechsteWoche">Weiter</button>
        <button type="button" @onclick="AktuelleWoche">Heute</button>
    </div>

    <div class="week-plan">
        @foreach (var datum in Wochentage())
        {
            var auftraegeAmTag = AuftraegeAmTag(datum);

            <section class="day-section">
                <h2>@Tagesueberschrift(datum)</h2>

                @if (auftraegeAmTag.Count == 0)
                {
                    <p class="empty-message">Keine Aufträge</p>
                }
                else
                {
                    <div class="order-list">
                        @foreach (var auftrag in auftraegeAmTag)
                        {
                            <button type="button" class="order-card" @onclick="() => AuftragOeffnen(auftrag)">
                                <strong>@auftrag.Titel</strong>
                                <span>@(auftrag.Kunde?.Firmenname ?? "Kein Kunde")</span>
                                <span>@auftrag.Startdatum.ToString("dd.MM.") - @auftrag.Enddatum.ToString("dd.MM.yyyy")</span>
                                <span>@(auftrag.Mitarbeiter.Count > 0 ? "Besetzt" : "Offen")@MitarbeiterText(auftrag)</span>
                            </button>
                        }
                    </div>
                }
            </section>
        }
    </div>
</div>

@if (ausgewaehlterAuftrag != null)
{
    <AuftragPopup Auftrag="@ausgewaehlterAuftrag"
                   Aktualisiert="DatenLaden"
                   Geschlossen="PopupSchliessen" />
}

@code {
    private List<Auftrag> auftraege = new();
    private DateTime wochenbeginn = MontagDerWoche(DateTime.Today);
    private Auftrag? ausgewaehlterAuftrag;

    protected override async Task OnInitializedAsync()
    {
        await DatenLaden();
    }

    private async Task DatenLaden()
    {
        auftraege = await AuftragService.GetAllAsync();
    }

    private static DateTime MontagDerWoche(DateTime datum)
    {
        var abstand = (int)datum.DayOfWeek - (int)DayOfWeek.Monday;

        if (abstand < 0)
        {
            abstand = 6;
        }

        return datum.Date.AddDays(-abstand);
    }

    private List<DateTime> Wochentage()
    {
        var tage = new List<DateTime>();

        for (var tag = 0; tag < 7; tag++)
        {
            tage.Add(wochenbeginn.AddDays(tag));
        }

        return tage;
    }

    private List<Auftrag> AuftraegeAmTag(DateTime datum)
    {
        var passendeAuftraege = new List<Auftrag>();

        foreach (var auftrag in auftraege)
        {
            if (datum.Date >= auftrag.Startdatum.Date && datum.Date <= auftrag.Enddatum.Date)
            {
                passendeAuftraege.Add(auftrag);
            }
        }

        return passendeAuftraege;
    }

    private void VorherigeWoche()
    {
        wochenbeginn = wochenbeginn.AddDays(-7);
    }

    private void NaechsteWoche()
    {
        wochenbeginn = wochenbeginn.AddDays(7);
    }

    private void AktuelleWoche()
    {
        wochenbeginn = MontagDerWoche(DateTime.Today);
    }

    private string Wochenzeitraum()
    {
        return wochenbeginn.ToString("dd.MM.") + " - " + wochenbeginn.AddDays(6).ToString("dd.MM.yyyy");
    }

    private string Tagesueberschrift(DateTime datum)
    {
        return datum.ToString("dddd, dd.MM.", System.Globalization.CultureInfo.GetCultureInfo("de-DE"));
    }

    private string MitarbeiterText(Auftrag auftrag)
    {
        var namen = string.Empty;

        foreach (var mitarbeiter in auftrag.Mitarbeiter)
        {
            if (namen != string.Empty)
            {
                namen += ", ";
            }

            namen += mitarbeiter.Vorname + " " + mitarbeiter.Nachname;
        }

        if (namen == string.Empty)
        {
            return string.Empty;
        }

        return " · " + namen;
    }

    private void AuftragOeffnen(Auftrag auftrag)
    {
        ausgewaehlterAuftrag = auftrag;
    }

    private void PopupSchliessen()
    {
        ausgewaehlterAuftrag = null;
    }
}
