@page "/disposition/wochenplan"
@rendermode InteractiveServer

@using HRomance.Models
@using HRomance.Services
@using HRomance.Components.Pages.Auftraege

@inject AuftragService AuftragService

<PageTitle>Wochenplan</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Wochenplan</h3>
    <a href="/disposition" class="btn btn-outline-secondary">Zurück</a>
</div>

@if (!auftraege.Any())
{
    <div class="alert alert-info">
        Für die nächsten 7 Tage sind keine Aufträge vorhanden.
    </div>
}
else
{
    <table class="table table-striped table-hover">

        <thead>
            <tr>
                <th>Titel</th>
                <th>Kunde</th>
                <th>Einsatzort</th>
                <th>Qualifikation</th>
                <th>Startdatum</th>
                <th>Enddatum</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var auftrag in auftraege)
            {
                <tr style="cursor: pointer;" @onclick="() => AuftragOeffnen(auftrag)">
                    <td>@auftrag.Titel</td>
                    <td>@auftrag.Kunde?.Firmenname</td>
                    <td>@auftrag.Einsatzort</td>
                    <td>@auftrag.BenoetigteQualifikation</td>
                    <td>@auftrag.Startdatum.ToShortDateString()</td>
                    <td>@auftrag.Enddatum.ToShortDateString()</td>

                    <td>
                        @if (auftrag.Mitarbeiter.Count > 0)
                        {
                            <span class="badge bg-success">Besetzt</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Offen</span>
                        }
                    </td>
                </tr>
            }

        </tbody>

    </table>
}

@if (ausgewaehlterAuftrag != null)
{
    <AuftragPopup Auftrag="@ausgewaehlterAuftrag"
                   Aktualisiert="DatenLaden"
                   Geschlossen="PopupSchliessen" />
}

@code {

    private List<Auftrag> auftraege = new();
    private Auftrag? ausgewaehlterAuftrag;

    protected override async Task OnInitializedAsync()
    {
        await DatenLaden();
    }

    private async Task DatenLaden()
    {
        var alleAuftraege = await AuftragService.GetAllAsync();

        var heute = DateTime.Today;
        var ende = heute.AddDays(7);

        auftraege = alleAuftraege
            .Where(a => a.Startdatum.Date >= heute &&
                        a.Startdatum.Date <= ende)
            .OrderBy(a => a.Startdatum)
            .ToList();
    }

    private void AuftragOeffnen(Auftrag auftrag)
    {
        ausgewaehlterAuftrag = auftrag;
    }

    private void PopupSchliessen()
    {
        ausgewaehlterAuftrag = null;
    }

}
