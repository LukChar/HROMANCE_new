@page "/antraege"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using HRomance.Data
@using HRomance.Models
@using HRomance.Services
@using Microsoft.AspNetCore.Identity

@inject AbwesenheitService AbwesenheitService
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Anträge</PageTitle>

<div class="applications-page">
    <div class="page-header">
        <div>
            <h1>Anträge</h1>
            <p>Urlaubs- und Abwesenheitsanträge</p>
        </div>

        <button type="button" class="btn btn-primary" @onclick="NeuerAntragOeffnen">
            Neuer Antrag
        </button>
    </div>

    <div class="overview">
        <div>
            <span>Offen</span>
            <strong>@anzahlOffen</strong>
        </div>
        <div>
            <span>Genehmigt</span>
            <strong>@anzahlGenehmigt</strong>
        </div>
        <div>
            <span>Abgelehnt</span>
            <strong>@anzahlAbgelehnt</strong>
        </div>
    </div>

    <div class="filters">
        <input type="text"
               placeholder="Anträge suchen..."
               value="@suchtext"
               @oninput="SucheGeaendert" />

        <select value="@artfilter" @onchange="ArtfilterGeaendert">
            <option value="Alle">Alle Arten</option>
            <option value="Urlaub">Urlaub</option>
            <option value="Zeitausgleich">Zeitausgleich</option>
            <option value="Krankenstand">Krankenstand</option>
            <option value="Sonstige Abwesenheit">Sonstige Abwesenheit</option>
        </select>

        <select value="@statusfilter" @onchange="StatusfilterGeaendert">
            <option value="Alle">Alle Status</option>
            <option value="Offen">Offen</option>
            <option value="Genehmigt">Genehmigt</option>
            <option value="Abgelehnt">Abgelehnt</option>
        </select>

        <select value="@sortierung" @onchange="SortierungGeaendert">
            <option value="Neueste">Neueste zuerst</option>
            <option value="Älteste">Älteste zuerst</option>
        </select>
    </div>

    <div class="applications-list">
        @if (antraege.Count == 0)
        {
            <p class="empty-message">Es sind noch keine Anträge vorhanden.</p>
        }
        else if (GefilterteAntraege().Count == 0)
        {
            <p class="empty-message">Keine Anträge gefunden.</p>
        }
        else
        {
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Mitarbeiter</th>
                            <th>Typ</th>
                            <th>Von</th>
                            <th>Bis</th>
                            <th>Grund</th>
                            <th>Status</th>
                            <th>Aktionen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var antrag in GefilterteAntraege())
                        {
                            <tr>
                                <td>@MitarbeiterName(antrag.Mitarbeiter)</td>
                                <td>@antrag.Typ</td>
                                <td>@antrag.Von.ToString("dd.MM.yyyy")</td>
                                <td>@antrag.Bis.ToString("dd.MM.yyyy")</td>
                                <td>@(string.IsNullOrWhiteSpace(antrag.Grund) ? "-" : antrag.Grund)</td>
                                <td>@antrag.Status</td>
                                <td>
                                    <AuthorizeView Roles="Admin,Disponent">
                                        @if (antrag.Status == "Offen")
                                        {
                                            <div class="action-buttons">
                                                <button type="button" class="approve-button"
                                                        @onclick='() => BestaetigungOeffnen(antrag, "Genehmigt")'>
                                                    Genehmigen
                                                </button>
                                                <button type="button" class="reject-button"
                                                        @onclick='() => BestaetigungOeffnen(antrag, "Abgelehnt")'>
                                                    Ablehnen
                                                </button>
                                            </div>
                                        }
                                    </AuthorizeView>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (neuerAntragSichtbar)
{
    <div class="popup-background" @onclick="NeuerAntragSchliessen">
        <div class="status-popup" @onclick:stopPropagation="true">
            <h2>Neuer Antrag</h2>

            <EditForm Model="@neuerAntrag" OnValidSubmit="NeuenAntragSpeichern" FormName="NeuerAntrag">
                <DataAnnotationsValidator />

                <div class="request-form">
                    <div>
                        <label>Art</label>
                        <InputSelect @bind-Value="neuerAntrag.Typ">
                            <option value="Urlaub">Urlaub</option>
                            <option value="Zeitausgleich">Zeitausgleich</option>
                            <option value="Krankenstand">Krankenstand</option>
                            <option value="Sonstige Abwesenheit">Sonstige Abwesenheit</option>
                        </InputSelect>
                    </div>

                    <div>
                        <label>Von</label>
                        <InputDate @bind-Value="neuerAntrag.Von" />
                    </div>

                    <div>
                        <label>Bis</label>
                        <InputDate @bind-Value="neuerAntrag.Bis" />
                    </div>

                    <div>
                        <label>Grund / Notiz</label>
                        <InputTextArea @bind-Value="neuerAntrag.Grund" />
                    </div>
                </div>

                @if (antragFehler != string.Empty)
                {
                    <p class="form-error">@antragFehler</p>
                }

                <div class="popup-actions">
                    <button type="button" class="cancel-button" @onclick="NeuerAntragSchliessen">Abbrechen</button>
                    <button type="submit" class="btn btn-primary" disabled="@speichertAntrag">
                        @(speichertAntrag ? "Wird gespeichert..." : "Antrag stellen")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (bestaetigungsAntrag != null)
{
    <div class="popup-background" @onclick="BestaetigungSchliessen">
        <div class="status-popup" @onclick:stopPropagation="true">
            <h2>Antrag @(neuerStatus == "Genehmigt" ? "genehmigen" : "ablehnen")?</h2>
            <div class="popup-details">
                <strong>@MitarbeiterName(bestaetigungsAntrag.Mitarbeiter)</strong>
                <span>Typ: @bestaetigungsAntrag.Typ</span>
                <span>Von: @bestaetigungsAntrag.Von.ToString("dd.MM.yyyy")</span>
                <span>Bis: @bestaetigungsAntrag.Bis.ToString("dd.MM.yyyy")</span>
                @if (!string.IsNullOrWhiteSpace(bestaetigungsAntrag.Grund))
                {
                    <span>Grund: @bestaetigungsAntrag.Grund</span>
                }
            </div>
            <div class="popup-actions">
                <button type="button" class="cancel-button" @onclick="BestaetigungSchliessen">Abbrechen</button>
                @if (neuerStatus == "Genehmigt")
                {
                    <button type="button" class="approve-button" @onclick="StatusBestaetigen">Genehmigen</button>
                }
                else
                {
                    <button type="button" class="reject-button" @onclick="StatusBestaetigen">Ablehnen</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<Abwesenheit> antraege = new();
    private int anzahlOffen;
    private int anzahlGenehmigt;
    private int anzahlAbgelehnt;
    private string suchtext = string.Empty;
    private string artfilter = "Alle";
    private string statusfilter = "Alle";
    private string sortierung = "Neueste";
    private Abwesenheit? bestaetigungsAntrag;
    private string neuerStatus = string.Empty;
    private int mitarbeiterId;
    private bool istManager;
    private bool neuerAntragSichtbar;
    private Abwesenheit neuerAntrag = new();
    private string antragFehler = string.Empty;
    private bool speichertAntrag;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateTask;
        var user = await UserManager.GetUserAsync(authenticationState.User);
        mitarbeiterId = user?.MitarbeiterId ?? 0;
        istManager = authenticationState.User.IsInRole("Admin")
            || authenticationState.User.IsInRole("Disponent");

        await AntraegeLaden();
    }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private async Task AntraegeLaden()
    {
        if (istManager)
        {
            antraege = await AbwesenheitService.GetAllAsync();
        }
        else if (mitarbeiterId != 0)
        {
            antraege = await AbwesenheitService.GetByMitarbeiterAsync(mitarbeiterId);
        }
        else
        {
            antraege = new List<Abwesenheit>();
        }

        anzahlOffen = 0;
        anzahlGenehmigt = 0;
        anzahlAbgelehnt = 0;

        foreach (var antrag in antraege)
        {
            if (antrag.Status == "Offen")
            {
                anzahlOffen++;
            }
            else if (antrag.Status == "Genehmigt")
            {
                anzahlGenehmigt++;
            }
            else if (antrag.Status == "Abgelehnt")
            {
                anzahlAbgelehnt++;
            }
        }
    }

    private List<Abwesenheit> GefilterteAntraege()
    {
        return AbwesenheitService.FilternUndSortieren(
            antraege,
            suchtext,
            artfilter,
            statusfilter,
            sortierung == "Neueste");
    }

    private void SucheGeaendert(ChangeEventArgs e)
    {
        suchtext = e.Value?.ToString() ?? string.Empty;
    }

    private void ArtfilterGeaendert(ChangeEventArgs e)
    {
        artfilter = e.Value?.ToString() ?? "Alle";
    }

    private void StatusfilterGeaendert(ChangeEventArgs e)
    {
        statusfilter = e.Value?.ToString() ?? "Alle";
    }

    private void SortierungGeaendert(ChangeEventArgs e)
    {
        sortierung = e.Value?.ToString() ?? "Neueste";
    }

    private void NeuerAntragOeffnen()
    {
        neuerAntrag = new Abwesenheit
        {
            MitarbeiterId = mitarbeiterId,
            Typ = "Urlaub",
            Von = DateTime.Today,
            Bis = DateTime.Today,
            Status = "Offen"
        };

        antragFehler = string.Empty;
        neuerAntragSichtbar = true;
    }

    private void NeuerAntragSchliessen()
    {
        if (speichertAntrag)
        {
            return;
        }

        neuerAntragSichtbar = false;
        neuerAntrag = new Abwesenheit();
        antragFehler = string.Empty;
    }

    private async Task NeuenAntragSpeichern()
    {
        if (speichertAntrag)
        {
            return;
        }

        if (mitarbeiterId == 0)
        {
            antragFehler = "Dem Benutzer ist kein Mitarbeiter zugeordnet.";
            return;
        }

        if (neuerAntrag.Bis.Date < neuerAntrag.Von.Date)
        {
            antragFehler = "Das Bis-Datum darf nicht vor dem Von-Datum liegen.";
            return;
        }

        speichertAntrag = true;

        try
        {
            var gespeichert = await AbwesenheitService.PersoenlichenAntragHinzufuegenAsync(
                neuerAntrag,
                mitarbeiterId);

            if (!gespeichert)
            {
                antragFehler = "Der Antrag konnte nicht gespeichert werden.";
                return;
            }

            speichertAntrag = false;
            NeuerAntragSchliessen();
            await AntraegeLaden();
        }
        catch
        {
            antragFehler = "Der Antrag konnte nicht gespeichert werden.";
        }
        finally
        {
            speichertAntrag = false;
        }
    }

    private void BestaetigungOeffnen(Abwesenheit antrag, string status)
    {
        if (!istManager)
        {
            return;
        }

        bestaetigungsAntrag = antrag;
        neuerStatus = status;
    }

    private void BestaetigungSchliessen()
    {
        bestaetigungsAntrag = null;
        neuerStatus = string.Empty;
    }

    private async Task StatusBestaetigen()
    {
        if (!istManager || bestaetigungsAntrag == null)
        {
            return;
        }

        await AbwesenheitService.StatusAendernAsync(bestaetigungsAntrag.Id, neuerStatus);
        BestaetigungSchliessen();
        await AntraegeLaden();
    }

    private string MitarbeiterName(Mitarbeiter? mitarbeiter)
    {
        if (mitarbeiter == null)
        {
            return "Unbekannter Mitarbeiter";
        }

        return mitarbeiter.Vorname + " " + mitarbeiter.Nachname;
    }
}
