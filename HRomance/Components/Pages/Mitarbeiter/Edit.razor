@page "/mitarbeiter/edit/{Id:int}"
@rendermode InteractiveServer

@using HRomance.Models
@using HRomance.Services

@inject MitarbeiterService MitarbeiterService
@inject NavigationManager Navigation

<PageTitle>Mitarbeiter bearbeiten</PageTitle>

<h3>Mitarbeiter bearbeiten</h3>

@if (mitarbeiter == null)
{
    <p>Lade Daten...</p>
}
else
{
    <EditForm Model="mitarbeiter" OnValidSubmit="Speichern">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Personalnummer</label>
            <InputText class="form-control"
                       @bind-Value="mitarbeiter.Personalnummer" />
        </div>

        <div class="mb-3">
            <label class="form-label">Vorname</label>
            <InputText class="form-control"
                       @bind-Value="mitarbeiter.Vorname" />
        </div>

        <div class="mb-3">
            <label class="form-label">Nachname</label>
            <InputText class="form-control"
                       @bind-Value="mitarbeiter.Nachname" />
        </div>

        <div class="mb-3">
            <label class="form-label">Qualifikation</label>
            <InputText class="form-control"
                       @bind-Value="mitarbeiter.Qualifikation" />
        </div>

        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input"
                           @bind-Value="mitarbeiter.Verfuegbar" />

            <label class="form-check-label">
                Verfügbar
            </label>
        </div>

        <button class="btn btn-success me-2" type="submit">
            Speichern
        </button>

        <button class="btn btn-secondary"
                type="button"
                @onclick="Zurueck">
            Abbrechen
        </button>

    </EditForm>
}

@code {

    [Parameter]
    public int Id { get; set; }

    private Mitarbeiter? mitarbeiter;

    protected override async Task OnInitializedAsync()
    {
        mitarbeiter = await MitarbeiterService.GetByIdAsync(Id);
    }

    private async Task Speichern()
    {
        if (mitarbeiter != null)
        {
            await MitarbeiterService.UpdateAsync(mitarbeiter);
            Navigation.NavigateTo("/mitarbeiter");
        }
    }

    private void Zurueck()
    {
        Navigation.NavigateTo("/mitarbeiter");
    }

}