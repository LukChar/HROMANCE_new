@page "/mitarbeiter"
@rendermode InteractiveServer

@using HRomance.Models
@using HRomance.Services

@inject MitarbeiterService MitarbeiterService
@inject NavigationManager Navigation

<PageTitle>Mitarbeiter</PageTitle>

<h3>Mitarbeiterverwaltung</h3>

<button type="button" class="btn btn-primary mb-3" @onclick="NeuerMitarbeiter">
    Neuer Mitarbeiter
</button>

<div class="row mb-3">

    <div class="col-md-8">
        <InputText class="form-control"
                   @bind-Value="suchbegriff"
                   placeholder="Suche nach Personalnummer, Vorname, Nachname oder Qualifikation..." />
    </div>

    <div class="col-md-4">
        <InputSelect class="form-select"
                     @bind-Value="verfuegbarFilter">

            <option value="">Alle</option>
            <option value="true">Verfügbar</option>
            <option value="false">Nicht verfügbar</option>

        </InputSelect>
    </div>

</div>

@if (!mitarbeiterListe.Any())
{
    <div class="alert alert-info">
        Es sind keine Mitarbeiter vorhanden.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Aktionen</th>
                <th>Personalnummer</th>
                <th>Vorname</th>
                <th>Nachname</th>
                <th>Qualifikation</th>
                <th>Verfügbar</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var mitarbeiter in mitarbeiterListe
               .Where(m =>(string.IsNullOrWhiteSpace(suchbegriff)
                || m.Personalnummer.Contains(suchbegriff, StringComparison.OrdinalIgnoreCase)
                || m.Vorname.Contains(suchbegriff, StringComparison.OrdinalIgnoreCase)
                || m.Nachname.Contains(suchbegriff, StringComparison.OrdinalIgnoreCase)
                || m.Qualifikation.Contains(suchbegriff, StringComparison.OrdinalIgnoreCase))
        &&
        (!verfuegbarFilter.HasValue || m.Verfuegbar == verfuegbarFilter.Value)
    ))
            {
                <tr>
                    <td>
                        <button class="btn btn-info btn-sm me-2"
                                @onclick="() => Details(mitarbeiter.Id)">
                            Details
                        </button>

                        <button class="btn btn-warning btn-sm me-2"
                                @onclick="() => Bearbeiten(mitarbeiter.Id)">
                            Bearbeiten
                        </button>

                        <button class="btn btn-danger btn-sm"
                                @onclick="() => Loeschen(mitarbeiter.Id)">
                            Löschen
                        </button>
                    </td>

                    <td>@mitarbeiter.Personalnummer</td>
                    <td>@mitarbeiter.Vorname</td>
                    <td>@mitarbeiter.Nachname</td>
                    <td>@mitarbeiter.Qualifikation</td>
                    <td>@(mitarbeiter.Verfuegbar ? "Ja" : "Nein")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code
{
    private List<Mitarbeiter> mitarbeiterListe = new();

    private string suchbegriff = string.Empty;

    private bool? verfuegbarFilter = null;

    protected override async Task OnInitializedAsync()
    {
        mitarbeiterListe = await MitarbeiterService.GetAllAsync();
    }

    private void NeuerMitarbeiter()
    {
        Navigation.NavigateTo("/mitarbeiter/create");
    }

    private void Bearbeiten(int id)
    {
        Navigation.NavigateTo($"/mitarbeiter/edit/{id}");
    }

    private async Task Loeschen(int id)
    {
        await MitarbeiterService.DeleteAsync(id);

        mitarbeiterListe = await MitarbeiterService.GetAllAsync();
    }

    private void Details(int id)
    {
        Navigation.NavigateTo($"/mitarbeiter/details/{id}");
    }
}