@page "/qualifikationen"
@rendermode InteractiveServer

@using HRomance.Models
@using HRomance.Services

@inject QualifikationService QualifikationService

<PageTitle>Qualifikationen</PageTitle>

<div class="qualifikationen-page">
    <div class="page-header">
        <div>
            <h1>Qualifikationen</h1>
            <p>Verwaltung der verfügbaren Qualifikationen</p>
        </div>

        <a href="/qualifikationen/create" class="add-button">
            Qualifikation hinzufügen
        </a>
    </div>

    <div class="qualifikationen-list">
        <div class="list-header">
            <h2>Alle Qualifikationen</h2>
        </div>

        @if (qualifikationen.Count == 0)
        {
            <div class="empty-message">
                Es sind noch keine Qualifikationen vorhanden.
            </div>
        }
        else
        {
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Aktionen</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var qualifikation in qualifikationen)
                        {
                            <tr>
                                <td>@qualifikation.Name</td>
                                <td>
                                    <a href="/qualifikationen/edit/@qualifikation.Id"
                                       class="edit-button">
                                        Bearbeiten
                                    </a>

                                    <button type="button"
                                            class="delete-button"
                                            @onclick="() => LoeschenBestaetigen(qualifikation.Id)">
                                        Löschen
                                    </button>

                                    @if (qualifikationZumLoeschen == qualifikation.Id)
                                    {
                                        <div class="delete-confirmation">
                                            <p>Möchtest du diese Qualifikation wirklich löschen?</p>

                                            <div class="confirmation-actions">
                                                <button type="button"
                                                        class="cancel-button"
                                                        @onclick="LoeschenAbbrechen">
                                                    Abbrechen
                                                </button>

                                                <button type="button"
                                                        class="delete-button"
                                                        @onclick="EndgueltigLoeschen">
                                                    Endgültig löschen
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<Qualifikation> qualifikationen = new List<Qualifikation>();
    private int? qualifikationZumLoeschen;

    protected override async Task OnInitializedAsync()
    {
        qualifikationen = await QualifikationService.GetAllAsync();
    }

    private void LoeschenBestaetigen(int id)
    {
        qualifikationZumLoeschen = id;
    }

    private void LoeschenAbbrechen()
    {
        qualifikationZumLoeschen = null;
    }

    private async Task EndgueltigLoeschen()
    {
        if (qualifikationZumLoeschen != null)
        {
            await QualifikationService.DeleteAsync(qualifikationZumLoeschen.Value);
            qualifikationen = await QualifikationService.GetAllAsync();
            qualifikationZumLoeschen = null;
        }
    }
}
