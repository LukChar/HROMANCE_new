    private string AusgewaehlterMitarbeiterName()
    {
        var mitarbeiter = mitarbeiterListe.Find(m => m.Id == mitarbeiterId);

        if (mitarbeiter == null)
        {
            return "Kein Mitarbeiter zugeordnet";
        }

        return MitarbeiterName(mitarbeiter);
    }

    private string MonatsstundenAnzeigen()
    {
        var stunden = ArbeitszeitService.BerechneMonatsstunden(
            arbeitszeiten,
            mitarbeiterId,
            angezeigterMonat.Year,
            angezeigterMonat.Month);

        var kultur = CultureInfo.GetCultureInfo("de-DE");
        return Math.Round(stunden, 1).ToString("0.#", kultur);
    }

    private int ErsterWochentag()
    {
        var wochentag = (int)angezeigterMonat.DayOfWeek;

        if (wochentag == 0)
        {
            return 6;
        }

        return wochentag - 1;
    }

    private int AnzahlKalenderfelder()
    {
        var anzahlTage = DateTime.DaysInMonth(angezeigterMonat.Year, angezeigterMonat.Month);
        var benoetigteFelder = ErsterWochentag() + anzahlTage;
        var anzahlWochen = (benoetigteFelder + 6) / 7;

        return anzahlWochen * 7;
    }

    private List<Auftrag> AuftraegeAmTag(DateTime datum)
    {
        var passendeAuftraege = new List<Auftrag>();

        foreach (var auftrag in auftraege)
        {
            if (datum.Date >= auftrag.Startdatum.Date
                && datum.Date <= auftrag.Enddatum.Date
                && AuftragService.PasstZuMitarbeiter(auftrag, mitarbeiterId))
            {
                passendeAuftraege.Add(auftrag);
            }
        }

        return passendeAuftraege;
    }

    private List<Arbeitszeit> ArbeitszeitenAmTag(DateTime datum)
    {
        var passendeArbeitszeiten = new List<Arbeitszeit>();

        foreach (var arbeitszeit in arbeitszeiten)
        {
            if (arbeitszeit.Datum.Date == datum.Date
                && arbeitszeit.MitarbeiterId == mitarbeiterId)
            {
                passendeArbeitszeiten.Add(arbeitszeit);
            }
        }

        return passendeArbeitszeiten;
    }

    private string StundenAnzeigen(double stunden)
    {
        var dauer = TimeSpan.FromHours(Math.Abs(stunden));
        var vorzeichen = stunden < 0 ? "-" : string.Empty;
        return vorzeichen + (int)dauer.TotalHours + ":" + dauer.Minutes.ToString("00");
    }

    private List<Abwesenheit> AbwesenheitenAmTag(DateTime datum)
    {
        var passendeAbwesenheiten = new List<Abwesenheit>();

        foreach (var abwesenheit in abwesenheiten)
        {
            if (datum.Date >= abwesenheit.Von.Date
                && datum.Date <= abwesenheit.Bis.Date
                && abwesenheit.MitarbeiterId == mitarbeiterId)
            {
                passendeAbwesenheiten.Add(abwesenheit);
            }
        }

        return passendeAbwesenheiten;
    }

    private void AbwesenheitsspurenAktualisieren()
    {
        abwesenheitsspuren = AbwesenheitService.KalenderSpurenBestimmen(abwesenheiten);
    }

    private int HoechsteAbwesenheitsspurAmTag(List<Abwesenheit> abwesenheitenAmTag)
    {
        var hoechsteSpur = -1;

        foreach (var abwesenheit in abwesenheitenAmTag)
        {
            if (abwesenheitsspuren.TryGetValue(abwesenheit.Id, out var spur)
                && spur > hoechsteSpur)
            {
                hoechsteSpur = spur;
            }
        }

        return hoechsteSpur;
    }

    private Abwesenheit? AbwesenheitInSpur(
        List<Abwesenheit> abwesenheitenAmTag,
        int gesuchteSpur)
    {
        foreach (var abwesenheit in abwesenheitenAmTag)
        {
            if (abwesenheitsspuren.TryGetValue(abwesenheit.Id, out var spur)
                && spur == gesuchteSpur)
            {
                return abwesenheit;
            }
        }

        return null;
    }

