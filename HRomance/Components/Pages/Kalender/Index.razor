@page "/kalender"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.Globalization
@using HRomance.Data
@using HRomance.Models
@using HRomance.Services
@using Microsoft.AspNetCore.Identity

@inject AuftragService AuftragService
@inject MitarbeiterService MitarbeiterService
@inject ArbeitszeitService ArbeitszeitService
@inject AbwesenheitService AbwesenheitService
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Kalender</PageTitle>

<div class="kalender-page">
    <div class="page-header">
        <h1>Kalender</h1>
        <p>Mein persönlicher Kalender</p>
    </div>

    <div class="employee-summary">
        <strong>@AusgewaehlterMitarbeiterName()</strong>
        @if (mitarbeiterId == 0)
        {
            <span>Dem Benutzer ist kein Mitarbeiter zugeordnet.</span>
        }
        else
        {
            <span>@Monatsname() · @MonatsstundenAnzeigen() Arbeitsstunden</span>
        }
    </div>

    <div class="calendar-card">
        <div class="month-navigation">
            <button type="button" class="navigation-button" @onclick="VorherigerMonat">
                Zurück
            </button>

            <h2>@Monatsname()</h2>

            <button type="button" class="navigation-button" @onclick="NaechsterMonat">
                Weiter
            </button>
        </div>

        <div class="today-area">
            <button type="button" class="today-button" @onclick="AktuellerMonat">
                Heute
            </button>
        </div>

        <div class="calendar-container">
            <div class="calendar-grid">
                @foreach (var wochentag in wochentage)
                {
                    <div class="weekday">@wochentag</div>
                }

                @for (var feld = 0; feld < AnzahlKalenderfelder(); feld++)
                {
                    var tag = feld - ErsterWochentag() + 1;

                    if (tag < 1 || tag > DateTime.DaysInMonth(angezeigterMonat.Year, angezeigterMonat.Month))
                    {
                        <div class="day empty-day"></div>
                    }
                    else
                    {
                        var datum = new DateTime(angezeigterMonat.Year, angezeigterMonat.Month, tag);
                        var abwesenheitenAmTag = AbwesenheitenAmTag(datum);
                        var auftraegeAmTag = AuftraegeAmTag(datum);
                        var arbeitszeitenAmTag = ArbeitszeitenAmTag(datum);
                        var anzahlEintraege = abwesenheitenAmTag.Count + auftraegeAmTag.Count + arbeitszeitenAmTag.Count;
                        var angezeigteEintraege = 0;

                        <div class="day @(IstAusgewaehlt(datum) ? "selected-day" : "")"
                             @onclick="() => TagAuswaehlen(datum)"
                             @ondblclick="() => EintragAmTagHinzufuegen(datum)">
                            <div class="day-number">@tag</div>

                            @for (var spur = 0; spur <= HoechsteAbwesenheitsspurAmTag(abwesenheitenAmTag); spur++)
                            {
                                var abwesenheit = AbwesenheitInSpur(abwesenheitenAmTag, spur);

                                @if (angezeigteEintraege < 4)
                                {
                                    angezeigteEintraege++;

                                    @if (abwesenheit == null)
                                    {
                                        <div class="absence-lane-placeholder"></div>
                                    }
                                    else
                                    {
                                        <div class="calendar-note absence-entry @AbwesenheitService.KalenderSegmentKlasse(abwesenheit, datum)"
                                             @onclick="() => AbwesenheitPopupOeffnen(abwesenheit)"
                                             @onclick:stopPropagation="true"
                                             @ondblclick:stopPropagation="true">
                                            @if (AbwesenheitService.IstKalenderSegmentStart(abwesenheit, datum))
                                            {
                                                <strong>@MitarbeiterName(abwesenheit.Mitarbeiter) · @abwesenheit.Typ · @abwesenheit.Status</strong>
                                            }
                                        </div>
                                    }
                                }
                            }

                            @foreach (var auftrag in auftraegeAmTag)
                            {
                                @if (angezeigteEintraege < 4)
                                {
                                    angezeigteEintraege++;
                                    <div class="calendar-entry @(auftrag.Besetzt ? "occupied" : "open")"
                                         @onclick="() => AuftragPopupOeffnen(auftrag)"
                                         @onclick:stopPropagation="true"
                                         @ondblclick:stopPropagation="true">
                                        <strong>@auftrag.Titel</strong>
                                        <span>· @(auftrag.Besetzt ? "Besetzt" : "Offen")</span>
                                    </div>
                                }
                            }

                            @foreach (var arbeitszeit in arbeitszeitenAmTag)
                            {
                                @if (angezeigteEintraege < 4)
                                {
                                    angezeigteEintraege++;
                                    <div class="calendar-note work-entry"
                                         @onclick="() => ArbeitszeitPopupOeffnen(arbeitszeit)"
                                         @onclick:stopPropagation="true"
                                         @ondblclick:stopPropagation="true">
                                        <strong>@MitarbeiterName(arbeitszeit.Mitarbeiter)</strong>
                                        <span>· @ArbeitszeitService.ZeitraumAnzeigen(arbeitszeit.Beginn, arbeitszeit.Ende)</span>
                                    </div>
                                }
                            }

                            @if (anzahlEintraege > 4)
                            {
                                <button type="button" class="more-entries"
                                        @onclick="() => TageslisteOeffnen(datum)"
                                        @onclick:stopPropagation="true"
                                        @ondblclick:stopPropagation="true">
                                    + @(anzahlEintraege - 4) weitere
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @if (ausgewaehltesDatum != null)
    {
        <div class="day-view">
            <div class="day-view-header">
                <div>
                    <h2>@DatumAnzeigen(ausgewaehltesDatum.Value)</h2>
                    <p>Einträge an diesem Tag</p>
                </div>

                <button type="button" class="add-entry-button" @onclick="EintragsauswahlAnzeigen">
                    Eintrag hinzufügen
                </button>
            </div>

            <div class="day-section">
                <h3>Aufträge</h3>

                @if (AuftraegeAmTag(ausgewaehltesDatum.Value).Count == 0)
                {
                    <p class="empty-message">Für diesen Tag sind keine Aufträge vorhanden.</p>
                }
                else
                {
                    <div class="day-entries">
                    @foreach (var auftrag in AuftraegeAmTag(ausgewaehltesDatum.Value))
                    {
                        <a class="day-entry" href="/auftraege/details/@auftrag.Id">
                            <strong>@auftrag.Titel</strong>
                            <span>Kunde: @(auftrag.Kunde?.Firmenname ?? "Kein Kunde")</span>
                            <span>Zeitraum: @auftrag.Startdatum.ToString("dd.MM.yyyy") bis @auftrag.Enddatum.ToString("dd.MM.yyyy")</span>
                            <span>Status: @(auftrag.Besetzt ? "Besetzt" : "Offen")</span>
                        </a>
                    }
                    </div>
                }
            </div>

            <div class="day-section">
                <h3>Arbeitszeiten</h3>

                @if (ArbeitszeitenAmTag(ausgewaehltesDatum.Value).Count == 0)
                {
                    <p class="empty-message">Für diesen Tag sind keine Arbeitszeiten vorhanden.</p>
                }
                else
                {
                    <div class="day-entries">
                        @foreach (var arbeitszeit in ArbeitszeitenAmTag(ausgewaehltesDatum.Value))
                        {
                            <div class="day-entry">
                                <strong>@MitarbeiterName(arbeitszeit.Mitarbeiter)</strong>
                                <span>@ArbeitszeitService.ZeitraumAnzeigen(arbeitszeit.Beginn, arbeitszeit.Ende)</span>
                                <span>Pause: @arbeitszeit.PauseMinuten Minuten</span>
                                <span>Gearbeitet: @StundenAnzeigen(ArbeitszeitService.BerechneArbeitsstunden(arbeitszeit)) Std.</span>
                                @if (!string.IsNullOrWhiteSpace(arbeitszeit.Notiz))
                                {
                                    <span>Notiz: @arbeitszeit.Notiz</span>
                                }
                                <div class="entry-actions">
                                    <button type="button" @onclick="() => ArbeitszeitBearbeiten(arbeitszeit)">Bearbeiten</button>
                                    <button type="button" class="delete-button" @onclick="() => ArbeitszeitLoeschen(arbeitszeit.Id)">Löschen</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="day-section">
                <h3>Abwesenheiten</h3>

                @if (AbwesenheitenAmTag(ausgewaehltesDatum.Value).Count == 0)
                {
                    <p class="empty-message">Für diesen Tag sind keine Abwesenheiten vorhanden.</p>
                }
                else
                {
                    <div class="day-entries">
                        @foreach (var abwesenheit in AbwesenheitenAmTag(ausgewaehltesDatum.Value))
                        {
                            <div class="day-entry">
                                <strong>@MitarbeiterName(abwesenheit.Mitarbeiter)</strong>
                                <span>@abwesenheit.Typ</span>
                                <span>@abwesenheit.Von.ToString("dd.MM.yyyy") bis @abwesenheit.Bis.ToString("dd.MM.yyyy")</span>
                                <span>Status: @abwesenheit.Status</span>
                                @if (!string.IsNullOrWhiteSpace(abwesenheit.Grund))
                                {
                                    <span>Grund: @abwesenheit.Grund</span>
                                }
                                <div class="entry-actions">
                                    <button type="button" @onclick="() => AbwesenheitBearbeiten(abwesenheit)">Bearbeiten</button>
                                    <button type="button" class="delete-button" @onclick="() => AbwesenheitLoeschen(abwesenheit.Id)">Löschen</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (popupSichtbar && popupArt == "ArbeitszeitBearbeiten")
            {
                <div class="popup-background" @onclick="PopupSchliessen">
                <div class="entry-popup" @onclick:stopPropagation="true">
                    <h2>Arbeitszeit bearbeiten</h2>

                    <EditForm Model="@bearbeiteteArbeitszeit"
                              OnValidSubmit="@ArbeitszeitAenderungenSpeichern"
                              FormName="ArbeitszeitBearbeiten">
                        <DataAnnotationsValidator />

                        <div class="entry-form">
                            <div class="form-group">
                                <label>Datum</label>
                                <InputDate class="form-input" @bind-Value="bearbeiteteArbeitszeit.Datum" />
                            </div>

                            <div class="form-group">
                                <label>Beginn</label>
                                <input class="form-input" type="text" placeholder="HH:mm"
                                       @bind="beginnText" @bind:event="oninput" />
                                @if (beginnFehler != string.Empty)
                                {
                                    <span class="form-error">@beginnFehler</span>
                                }
                            </div>

                            <div class="form-group">
                                <label>Ende</label>
                                <input class="form-input" type="text" placeholder="HH:mm"
                                       @bind="endeText" @bind:event="oninput" />
                                @if (endeFehler != string.Empty)
                                {
                                    <span class="form-error">@endeFehler</span>
                                }
                            </div>

                            <div class="form-group">
                                <label>Pause in Minuten</label>
                                <InputNumber class="form-input" @bind-Value="bearbeiteteArbeitszeit.PauseMinuten" />
                            </div>

                            <div class="form-group full-width">
                                <label>Notiz</label>
                                <InputTextArea class="form-input" @bind-Value="bearbeiteteArbeitszeit.Notiz" />
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(formularFehler))
                        {
                            <p class="form-error">@formularFehler</p>
                        }

                        <div class="form-actions">
                            <button type="button" class="cancel-button" @onclick="BearbeitungAbbrechen">Abbrechen</button>
                            <button type="submit" class="save-button">Speichern</button>
                        </div>
                    </EditForm>
                </div>
                </div>
            }
            else if (popupSichtbar && popupArt == "AbwesenheitBearbeiten")
            {
                <div class="popup-background" @onclick="PopupSchliessen">
                <div class="entry-popup" @onclick:stopPropagation="true">
                    <h2>Abwesenheit bearbeiten</h2>

                    <EditForm Model="@bearbeiteteAbwesenheit"
                              OnValidSubmit="@AbwesenheitAenderungenSpeichern"
                              FormName="AbwesenheitBearbeiten">
                        <DataAnnotationsValidator />

                        <div class="entry-form">
                            <div class="form-group">
                                <label>Von</label>
                                <InputDate class="form-input" @bind-Value="bearbeiteteAbwesenheit.Von" />
                            </div>

                            <div class="form-group">
                                <label>Bis</label>
                                <InputDate class="form-input" @bind-Value="bearbeiteteAbwesenheit.Bis" />
                            </div>

                            <div class="form-group">
                                <label>Typ</label>
                                <InputSelect class="form-input" @bind-Value="bearbeiteteAbwesenheit.Typ">
                                    <option value="Urlaub">Urlaub</option>
                                    <option value="Zeitausgleich">Zeitausgleich</option>
                                    <option value="Krankenstand">Krankenstand</option>
                                    <option value="Sonstige Abwesenheit">Sonstige Abwesenheit</option>
                                </InputSelect>
                            </div>

                            <div class="form-group full-width">
                                <label>Grund</label>
                                <InputTextArea class="form-input" @bind-Value="bearbeiteteAbwesenheit.Grund" />
                            </div>

                            <div class="form-group">
                                <label>Status</label>
                                <div class="status-value">@bearbeiteteAbwesenheit.Status</div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(formularFehler))
                        {
                            <p class="form-error">@formularFehler</p>
                        }

                        <div class="form-actions">
                            <button type="button" class="cancel-button" @onclick="BearbeitungAbbrechen">Abbrechen</button>
                            <button type="submit" class="save-button">Speichern</button>
                        </div>
                    </EditForm>
                </div>
                </div>
            }

            @if (popupSichtbar && popupArt == "Neu")
            {
                <div class="popup-background" @onclick="PopupSchliessen">
                <div class="entry-popup" @onclick:stopPropagation="true">
                    <h2>Eintrag hinzufügen</h2>
                    <h3>Was möchtest du eintragen?</h3>

                    <div class="entry-buttons">
                        <button type="button" @onclick='() => EintragsartAuswaehlen("Arbeitszeit")'>
                            Arbeitszeit
                        </button>
                        <button type="button" @onclick='() => EintragsartAuswaehlen("Urlaub")'>
                            Urlaub
                        </button>
                        <button type="button" @onclick='() => EintragsartAuswaehlen("Abwesenheit")'>
                            Abwesenheit
                        </button>
                    </div>

                    @if (string.IsNullOrEmpty(ausgewaehlteEintragsart))
                    {
                        <p>Bitte wähle eine Eintragsart aus.</p>
                    }
                    else if (ausgewaehlteEintragsart == "Arbeitszeit")
                    {
                        <EditForm Model="@neueArbeitszeit"
                                  OnValidSubmit="@ArbeitszeitSpeichern"
                                  FormName="ArbeitszeitErstellen">
                            <DataAnnotationsValidator />

                            <div class="entry-form">
                                <div class="form-group">
                                    <label>Datum</label>
                                    <InputDate class="form-input" @bind-Value="neueArbeitszeit.Datum" />
                                </div>

                                <div class="form-group">
                                    <label>Beginn</label>
                                    <input class="form-input" type="text" placeholder="HH:mm"
                                           @bind="beginnText" @bind:event="oninput" />
                                    @if (beginnFehler != string.Empty)
                                    {
                                        <span class="form-error">@beginnFehler</span>
                                    }
                                </div>

                                <div class="form-group">
                                    <label>Ende</label>
                                    <input class="form-input" type="text" placeholder="HH:mm"
                                           @bind="endeText" @bind:event="oninput" />
                                    @if (endeFehler != string.Empty)
                                    {
                                        <span class="form-error">@endeFehler</span>
                                    }
                                </div>

                                <div class="form-group">
                                    <label>Pause in Minuten</label>
                                    <InputNumber class="form-input" @bind-Value="neueArbeitszeit.PauseMinuten" />
                                </div>

                                <div class="form-group full-width">
                                    <label>Notiz</label>
                                    <InputTextArea class="form-input" @bind-Value="neueArbeitszeit.Notiz" />
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(formularFehler))
                            {
                                <p class="form-error">@formularFehler</p>
                            }

                            <div class="form-actions">
                                <button type="button" class="cancel-button" @onclick="EintragAbbrechen">Abbrechen</button>
                                <button type="submit" class="save-button">Speichern</button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <EditForm Model="@neueAbwesenheit"
                                  OnValidSubmit="@AbwesenheitSpeichern"
                                  FormName="AbwesenheitErstellen">
                            <DataAnnotationsValidator />

                            <div class="entry-form">
                                <div class="form-group">
                                    <label>Von</label>
                                    <InputDate class="form-input" @bind-Value="neueAbwesenheit.Von" />
                                </div>

                                <div class="form-group">
                                    <label>Bis</label>
                                    <InputDate class="form-input" @bind-Value="neueAbwesenheit.Bis" />
                                </div>

                                <div class="form-group">
                                    <label>Typ</label>
                                    <InputSelect class="form-input" @bind-Value="neueAbwesenheit.Typ">
                                        <option value="Urlaub">Urlaub</option>
                                        <option value="Zeitausgleich">Zeitausgleich</option>
                                        <option value="Krankenstand">Krankenstand</option>
                                        <option value="Sonstige Abwesenheit">Sonstige Abwesenheit</option>
                                    </InputSelect>
                                </div>

                                <div class="form-group full-width">
                                    <label>Grund</label>
                                    <InputTextArea class="form-input" @bind-Value="neueAbwesenheit.Grund" />
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(formularFehler))
                            {
                                <p class="form-error">@formularFehler</p>
                            }

                            <div class="form-actions">
                                <button type="button" class="cancel-button" @onclick="EintragAbbrechen">Abbrechen</button>
                                <button type="submit" class="save-button">Speichern</button>
                            </div>
                        </EditForm>
                    }

                </div>
                </div>
            }
        </div>
    }
</div>

@if (popupSichtbar && (popupArt == "Arbeitszeit" || popupArt == "Abwesenheit" || popupArt == "Auftrag" || popupArt == "Tagesliste"))
{
    <div class="popup-background" @onclick="PopupSchliessen">
        <div class="entry-popup" @onclick:stopPropagation="true">
            @if (popupArt == "Tagesliste" && popupTageslisteDatum != null)
            {
                <h2>@DatumAnzeigen(popupTageslisteDatum.Value)</h2>

                <div class="day-popup-list">
                    @foreach (var arbeitszeit in ArbeitszeitenAmTag(popupTageslisteDatum.Value))
                    {
                        <button type="button" class="day-popup-entry work-entry" @onclick="() => ArbeitszeitAusTageslisteOeffnen(arbeitszeit)">
                            <strong>Arbeitszeit: @MitarbeiterName(arbeitszeit.Mitarbeiter)</strong>
                            <span>@ArbeitszeitService.ZeitraumAnzeigen(arbeitszeit.Beginn, arbeitszeit.Ende)</span>
                        </button>
                    }

                    @foreach (var abwesenheit in AbwesenheitenAmTag(popupTageslisteDatum.Value))
                    {
                        <button type="button" class="day-popup-entry absence-entry" @onclick="() => AbwesenheitAusTageslisteOeffnen(abwesenheit)">
                            <strong>Abwesenheit: @MitarbeiterName(abwesenheit.Mitarbeiter)</strong>
                            <span>@abwesenheit.Typ</span>
                            <span>@abwesenheit.Status</span>
                        </button>
                    }

                    @foreach (var auftrag in AuftraegeAmTag(popupTageslisteDatum.Value))
                    {
                        <button type="button" class="day-popup-entry @(auftrag.Besetzt ? "occupied" : "open")" @onclick="() => AuftragAusTageslisteOeffnen(auftrag)">
                            <strong>Auftrag: @auftrag.Titel</strong>
                            <span>@(auftrag.Kunde?.Firmenname ?? "Kein Kunde") · @(auftrag.Besetzt ? "Besetzt" : "Offen")</span>
                        </button>
                    }
                </div>

                <div class="popup-actions">
                    <button type="button" @onclick="PopupSchliessen">Schließen</button>
                </div>
            }
            else if (popupArt == "Arbeitszeit" && popupArbeitszeit != null)
            {
                <h2>Arbeitszeit</h2>
                <div class="popup-details">
                    <strong>@MitarbeiterName(popupArbeitszeit.Mitarbeiter)</strong>
                    <span>Datum: @popupArbeitszeit.Datum.ToString("dd.MM.yyyy")</span>
                    <span>Beginn: @ArbeitszeitService.ZeitAnzeigen(popupArbeitszeit.Beginn)</span>
                    <span>Ende: @ArbeitszeitService.ZeitAnzeigen(popupArbeitszeit.Ende)</span>
                    <span>Pause: @popupArbeitszeit.PauseMinuten Minuten</span>
                    <span>Gearbeitet: @StundenAnzeigen(ArbeitszeitService.BerechneArbeitsstunden(popupArbeitszeit)) Std.</span>
                    @if (!string.IsNullOrWhiteSpace(popupArbeitszeit.Notiz))
                    {
                        <span>Notiz: @popupArbeitszeit.Notiz</span>
                    }
                </div>

                <div class="popup-actions">
                    <button type="button" @onclick="ArbeitszeitAusPopupBearbeiten">Bearbeiten</button>
                    <button type="button" class="popup-delete" @onclick="ArbeitszeitAusPopupLoeschen">Löschen</button>
                    <button type="button" @onclick="PopupSchliessen">Schließen</button>
                </div>
            }
            else if (popupArt == "Abwesenheit" && popupAbwesenheit != null)
            {
                <h2>Abwesenheit</h2>
                <div class="popup-details">
                    <strong>@MitarbeiterName(popupAbwesenheit.Mitarbeiter)</strong>
                    <span>Typ: @popupAbwesenheit.Typ</span>
                    <span>Von: @popupAbwesenheit.Von.ToString("dd.MM.yyyy")</span>
                    <span>Bis: @popupAbwesenheit.Bis.ToString("dd.MM.yyyy")</span>
                    @if (!string.IsNullOrWhiteSpace(popupAbwesenheit.Grund))
                    {
                        <span>Grund: @popupAbwesenheit.Grund</span>
                    }
                    <span>Status: @popupAbwesenheit.Status</span>
                </div>

                <div class="popup-actions">
                    <button type="button" @onclick="AbwesenheitAusPopupBearbeiten">Bearbeiten</button>
                    <button type="button" class="popup-delete" @onclick="AbwesenheitAusPopupLoeschen">Löschen</button>
                    <button type="button" @onclick="PopupSchliessen">Schließen</button>
                </div>
            }
            else if (popupArt == "Auftrag" && popupAuftrag != null)
            {
                <h2>Auftrag</h2>
                <div class="popup-details">
                    <strong>@popupAuftrag.Titel</strong>
                    <span>Kunde: @(popupAuftrag.Kunde?.Firmenname ?? "Kein Kunde")</span>
                    <span>Startdatum: @popupAuftrag.Startdatum.ToString("dd.MM.yyyy")</span>
                    <span>Enddatum: @popupAuftrag.Enddatum.ToString("dd.MM.yyyy")</span>
                    <span>Einsatzort: @popupAuftrag.Einsatzort</span>
                    <span>Beschreibung: @popupAuftrag.Beschreibung</span>
                    <span>Qualifikationen: @AuftragQualifikationen(popupAuftrag)</span>
                    <span>Mitarbeiter: @AuftragMitarbeiter(popupAuftrag)</span>
                    <span>Status: @(popupAuftrag.Mitarbeiter.Count > 0 ? "Besetzt" : "Offen")</span>
                </div>

                <div class="popup-actions">
                    <button type="button" @onclick="PopupSchliessen">Schließen</button>
                </div>
            }
