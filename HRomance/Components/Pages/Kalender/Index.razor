            {
                namen += ", ";
            }

            namen += mitarbeiter.Vorname + " " + mitarbeiter.Nachname;
        }

        return namen == string.Empty ? "Keine" : namen;
    }

    private string DatumAnzeigen(DateTime datum)
    {
