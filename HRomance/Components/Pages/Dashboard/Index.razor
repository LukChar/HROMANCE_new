@page "/dashboard"
@rendermode InteractiveServer

@using System.Globalization
@using HRomance.Components.Pages.Auftraege
@using HRomance.Models
@using HRomance.Services

@inject MitarbeiterService MitarbeiterService
@inject AuftragService AuftragService
@inject ArbeitszeitService ArbeitszeitService
@inject AbwesenheitService AbwesenheitService

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-page">
    <div class="page-header">
        <h1>Dashboard</h1>
        <p>Übersicht über Mitarbeiter, Aufträge, Anträge und Arbeitszeiten</p>
    </div>

    <div class="view-switch">
        <button type="button"
                class="@AnsichtsButtonKlasse(false)"
                @onclick="() => MitarbeiterAnsichtSetzen(false)">
            Manager-Ansicht
        </button>
        <button type="button"
                class="@AnsichtsButtonKlasse(true)"
                @onclick="() => MitarbeiterAnsichtSetzen(true)">
            Mitarbeiter-Ansicht
        </button>
    </div>

    <section class="dashboard-section working-time-overview">
        <div class="section-header">
            <h2>@(mitarbeiterAnsicht ? "Meine Arbeitszeit" : "Arbeitszeit")</h2>
        </div>

        <div class="working-time-content">
            <div class="employee-selection">
                <label for="dashboard-mitarbeiter">Mitarbeiter</label>
                <select id="dashboard-mitarbeiter" value="@ausgewaehlterMitarbeiterId" @onchange="MitarbeiterGeaendert">
                    <option value="0">Bitte auswählen</option>
                    @foreach (var person in mitarbeiter)
                    {
                        <option value="@person.Id">@person.Vorname @person.Nachname</option>
                    }
                </select>
            </div>

            @if (ausgewaehlterMitarbeiterId != 0)
            {
                <div class="working-time-value">
                    <strong>@AusgewaehlterMitarbeiterName()</strong>
                    <span>@AktuellerMonat()</span>
                    <div class="working-time-row">
                        <span>Arbeitszeit</span>
                        <strong>@StundenAnzeigen(MonatsIst()) h</strong>
                    </div>
                    @if (MonatsAbwesenheitstage() > 0)
                    {
                        <div class="working-time-row">
                            <span>Abwesenheit</span>
                            <strong>@AbwesenheitstageAnzeigen()</strong>
                        </div>
                    }
                    <div class="working-time-row">
                        <span>Soll</span>
                        <strong>@StundenAnzeigen(MonatsSoll()) h</strong>
                    </div>
                    <div class="working-time-row @SaldoKlasse()">
                        <span>Saldo</span>
                        <strong>@SaldoAnzeigen() h</strong>
                    </div>
                    <button type="button" class="add-working-time-button" @onclick="ArbeitszeitPopupOeffnen">
                        Stunden eintragen
                    </button>
                </div>
            }
        </div>
    </section>

    @if (!mitarbeiterAnsicht)
    {
        <div class="summary-grid">
        <div class="summary-card">
            <span>Mitarbeiter</span>
            <strong>@mitarbeiter.Count gesamt</strong>
            <small>@verfuegbareMitarbeiter verfügbar · @nichtVerfuegbareMitarbeiter nicht verfügbar</small>
        </div>
        <div class="summary-card">
            <span>Offene Aufträge</span>
            <strong>@offeneAuftraege</strong>
            <small>Noch ohne Mitarbeiter</small>
        </div>
        <div class="summary-card">
            <span>Besetzte Aufträge</span>
            <strong>@besetzteAuftraege</strong>
            <small>Mindestens ein Mitarbeiter</small>
        </div>
        <div class="summary-card">
            <span>Offene Anträge</span>
            <strong>@offeneAntraege.Count</strong>
            <small>Noch nicht bearbeitet</small>
        </div>
        </div>

        <div class="dashboard-grid">
        <section class="dashboard-section today-orders">
            <div class="section-header">
                <h2>Heutige Einsätze</h2>
            </div>

            @if (heutigeAuftraege.Count == 0)
            {
                <p class="empty-message">Heute finden keine Einsätze statt.</p>
            }
            else
            {
                <div class="entry-list">
                    @foreach (var auftrag in heutigeAuftraege)
                    {
                        <button type="button" class="dashboard-entry order-entry" @onclick="() => AuftragOeffnen(auftrag)">
                            <strong>@auftrag.Titel</strong>
                            <span>@(auftrag.Kunde?.Firmenname ?? "Kein Kunde")</span>
                            <span>Mitarbeiter: @MitarbeiterNamen(auftrag)</span>
                            <small>@(AuftragService.IstBesetzt(auftrag) ? "Besetzt" : "Offen")</small>
                        </button>
                    }
                </div>
            }
        </section>

        <section class="dashboard-section open-requests">
            <div class="section-header">
                <h2>Offene Anträge</h2>
            </div>

            @if (offeneAntraege.Count == 0)
            {
                <p class="empty-message">Es sind keine offenen Anträge vorhanden.</p>
            }
            else
            {
                <div class="entry-list">
                    @for (var i = 0; i < offeneAntraege.Count && i < 5; i++)
                    {
                        var antrag = offeneAntraege[i];
                        <div class="dashboard-entry compact-entry">
                            <strong>@MitarbeiterName(antrag.Mitarbeiter)</strong>
                            <span>@antrag.Typ · @antrag.Von.ToString("dd.MM.") - @antrag.Bis.ToString("dd.MM.")</span>
                        </div>
                    }
                </div>

                @if (offeneAntraege.Count > 5)
                {
                    <a class="section-link" href="/antraege">Alle Anträge anzeigen</a>
                }
            }
        </section>

        <section class="dashboard-section today-absent">
            <div class="section-header">
                <h2>Heute abwesend</h2>
            </div>

            @if (heutigeAbwesenheiten.Count == 0)
            {
                <p class="empty-message">Heute ist niemand abwesend.</p>
            }
            else
            {
                <div class="entry-list">
                    @foreach (var abwesenheit in heutigeAbwesenheiten)
                    {
                        <div class="dashboard-entry compact-entry">
                            <strong>@MitarbeiterName(abwesenheit.Mitarbeiter)</strong>
                            <span>@abwesenheit.Typ</span>
                        </div>
                    }
                </div>
            }
        </section>

        </div>
    }
    else
    {
        <div class="personal-grid">
            <section class="dashboard-section">
                <div class="section-header">
                    <h2>Meine nächsten Einsätze</h2>
                </div>

                @if (ausgewaehlterMitarbeiterId == 0)
                {
                    <p class="empty-message">Bitte einen Mitarbeiter auswählen.</p>
                }
                else if (PersoenlicheEinsaetze().Count == 0)
                {
                    <p class="empty-message">In den nächsten fünf Arbeitstagen sind keine Einsätze geplant.</p>
                }
                else
                {
                    <div class="entry-list">
                        @foreach (var auftrag in PersoenlicheEinsaetze())
                        {
                            <button type="button" class="dashboard-entry order-entry" @onclick="() => AuftragOeffnen(auftrag)">
                                <strong>@auftrag.Titel</strong>
                                <span>@(auftrag.Kunde?.Firmenname ?? "Kein Kunde")</span>
                                <span>@auftrag.Einsatzort</span>
                                <small>@auftrag.Startdatum.ToString("dd.MM.yyyy") - @auftrag.Enddatum.ToString("dd.MM.yyyy")</small>
                            </button>
                        }
                    </div>
                }
            </section>

            <section class="dashboard-section">
                <div class="section-header">
                    <h2>Meine Abwesenheiten / Anträge</h2>
                </div>

                @if (ausgewaehlterMitarbeiterId == 0)
                {
                    <p class="empty-message">Bitte einen Mitarbeiter auswählen.</p>
                }
                else if (PersoenlicheAbwesenheiten().Count == 0)
                {
                    <p class="empty-message">Es sind keine Abwesenheiten oder Anträge vorhanden.</p>
                }
                else
                {
                    <div class="entry-list">
                        @foreach (var abwesenheit in PersoenlicheAbwesenheiten())
                        {
                            <div class="dashboard-entry">
                                <strong>@abwesenheit.Typ</strong>
                                <span>@abwesenheit.Von.ToString("dd.MM.yyyy") - @abwesenheit.Bis.ToString("dd.MM.yyyy")</span>
                                <small>@abwesenheit.Status</small>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    }
</div>

@if (ausgewaehlterAuftrag != null)
{
    <AuftragPopup Auftrag="@ausgewaehlterAuftrag"
                   NurLesen="true"
                   Geschlossen="AuftragSchliessen" />
}

@if (arbeitszeitPopupSichtbar)
{
    <div class="popup-background" @onclick="ArbeitszeitPopupSchliessen">
        <div class="entry-popup" @onclick:stopPropagation="true">
            <h2>Arbeitszeit eintragen</h2>

            <EditForm Model="@neueArbeitszeit" OnValidSubmit="ArbeitszeitSpeichern" FormName="DashboardArbeitszeit">
                <DataAnnotationsValidator />

                <div class="entry-form">
                    <div class="form-group">
                        <label>Mitarbeiter</label>
                        <InputSelect class="form-input" @bind-Value="neueArbeitszeit.MitarbeiterId">
                            <option value="0">Bitte auswählen</option>
                            @foreach (var person in mitarbeiter)
                            {
                                <option value="@person.Id">@person.Vorname @person.Nachname</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => neueArbeitszeit.MitarbeiterId)" />
                    </div>

                    <div class="form-group">
                        <label>Datum</label>
                        <InputDate class="form-input" @bind-Value="neueArbeitszeit.Datum" />
                    </div>

                    <div class="form-group">
                        <label>Beginn</label>
                        <InputDate class="form-input" Type="InputDateType.Time" @bind-Value="neueArbeitszeit.Beginn" />
                    </div>

                    <div class="form-group">
                        <label>Ende</label>
                        <InputDate class="form-input" Type="InputDateType.Time" @bind-Value="neueArbeitszeit.Ende" />
                    </div>

                    <div class="form-group">
                        <label>Pause in Minuten</label>
                        <InputNumber class="form-input" @bind-Value="neueArbeitszeit.PauseMinuten" />
                    </div>

                    <div class="form-group full-width">
                        <label>Notiz</label>
                        <InputTextArea class="form-input" @bind-Value="neueArbeitszeit.Notiz" />
                    </div>
                </div>

                @if (arbeitszeitFehler != string.Empty)
                {
                    <p class="form-error">@arbeitszeitFehler</p>
                }

                <div class="popup-actions">
                    <button type="button" @onclick="ArbeitszeitPopupSchliessen">Abbrechen</button>
                    <button type="submit" class="save-button">Speichern</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<Mitarbeiter> mitarbeiter = new();
    private List<Auftrag> auftraege = new();
    private List<Arbeitszeit> arbeitszeiten = new();
    private List<Abwesenheit> abwesenheiten = new();
    private List<Auftrag> heutigeAuftraege = new();
    private List<Abwesenheit> offeneAntraege = new();
    private List<Abwesenheit> heutigeAbwesenheiten = new();
    private int verfuegbareMitarbeiter;
    private int nichtVerfuegbareMitarbeiter;
    private int offeneAuftraege;
    private int besetzteAuftraege;
    private int ausgewaehlterMitarbeiterId;
    private bool mitarbeiterAnsicht;
    private Auftrag? ausgewaehlterAuftrag;
    private bool arbeitszeitPopupSichtbar;
    private Arbeitszeit neueArbeitszeit = new();
    private string arbeitszeitFehler = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        mitarbeiter = await MitarbeiterService.GetAllAsync();
        auftraege = await AuftragService.GetAllAsync();
        arbeitszeiten = await ArbeitszeitService.GetAllAsync();
        abwesenheiten = await AbwesenheitService.GetAllAsync();

        foreach (var person in mitarbeiter)
        {
            if (person.Verfuegbar)
            {
                verfuegbareMitarbeiter++;
            }
            else
            {
                nichtVerfuegbareMitarbeiter++;
            }
        }

        foreach (var auftrag in auftraege)
        {
            if (AuftragService.IstBesetzt(auftrag))
            {
                besetzteAuftraege++;
            }
            else
            {
                offeneAuftraege++;
            }

            if (AuftragService.IstEinsatzAmTag(auftrag, DateTime.Today))
            {
                heutigeAuftraege.Add(auftrag);
            }
        }

        foreach (var abwesenheit in abwesenheiten)
        {
            if (AbwesenheitService.IstOffenerAntrag(abwesenheit))
            {
                offeneAntraege.Add(abwesenheit);
            }

            if (AbwesenheitService.IstAbwesendAmTag(abwesenheit, DateTime.Today))
            {
                heutigeAbwesenheiten.Add(abwesenheit);
            }
        }
    }

    private void MitarbeiterGeaendert(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out ausgewaehlterMitarbeiterId);
    }

    private void MitarbeiterAnsichtSetzen(bool istMitarbeiterAnsicht)
    {
        mitarbeiterAnsicht = istMitarbeiterAnsicht;
    }

    private string AnsichtsButtonKlasse(bool istMitarbeiterAnsicht)
    {
        if (mitarbeiterAnsicht == istMitarbeiterAnsicht)
        {
            return "view-button active-view";
        }

        return "view-button";
    }

    private List<Abwesenheit> PersoenlicheAbwesenheiten()
    {
        var ergebnis = new List<Abwesenheit>();

        foreach (var abwesenheit in abwesenheiten)
        {
            if (AbwesenheitService.PasstZuMitarbeiter(abwesenheit, ausgewaehlterMitarbeiterId))
            {
                ergebnis.Add(abwesenheit);
            }
        }

        return ergebnis;
    }

    private List<Auftrag> PersoenlicheEinsaetze()
    {
        var ergebnis = new List<Auftrag>();

        foreach (var auftrag in auftraege)
        {
            if (AuftragService.PasstZuMitarbeiter(auftrag, ausgewaehlterMitarbeiterId)
                && AuftragService.IstInNaechstenFuenfArbeitstagen(auftrag, DateTime.Today))
            {
                ergebnis.Add(auftrag);
            }
        }

        return ergebnis;
    }

    private double MonatsIst()
    {
        return Monatsauswertung().Arbeitszeit;
    }

    private double MonatsSoll()
    {
        var person = AusgewaehlterMitarbeiter();

        if (person == null)
        {
            return 0;
        }

        return Monatsauswertung().Soll;
    }

    private double MonatsSaldo()
    {
        return Monatsauswertung().Saldo;
    }

    private int MonatsAbwesenheitstage()
    {
        return Monatsauswertung().Abwesenheitstage;
    }

    private (double Arbeitszeit, double Soll, int Abwesenheitstage, double Saldo) Monatsauswertung()
    {
        var person = AusgewaehlterMitarbeiter();

        if (person == null)
        {
            return (0, 0, 0, 0);
        }

        return ArbeitszeitService.BerechneMonatsauswertung(
            arbeitszeiten,
            abwesenheiten,
            person.Id,
            DateTime.Today.Year,
            DateTime.Today.Month,
            person.Wochenarbeitszeit,
            DateTime.Today);
    }

    private string AbwesenheitstageAnzeigen()
    {
        var tage = MonatsAbwesenheitstage();
        return tage == 1 ? "1 Tag" : tage + " Tage";
    }

    private string StundenAnzeigen(double stunden)
    {
        var kultur = CultureInfo.GetCultureInfo("de-DE");
        return Math.Round(stunden, 1).ToString("0.0", kultur);
    }

    private string SaldoAnzeigen()
    {
        var saldo = MonatsSaldo();

        if (saldo > 0)
        {
            return "+" + StundenAnzeigen(saldo);
        }

        if (saldo < 0)
        {
            return StundenAnzeigen(saldo);
        }

        return "0";
    }

    private string SaldoKlasse()
    {
        var saldo = MonatsSaldo();

        if (saldo > 0)
        {
            return "positive-balance";
        }

        if (saldo < 0)
        {
            return "negative-balance";
        }

        return string.Empty;
    }

    private Mitarbeiter? AusgewaehlterMitarbeiter()
    {
        foreach (var person in mitarbeiter)
        {
            if (person.Id == ausgewaehlterMitarbeiterId)
            {
                return person;
            }
        }

        return null;
    }

    private string AusgewaehlterMitarbeiterName()
    {
        var person = AusgewaehlterMitarbeiter();

        if (person == null)
        {
            return string.Empty;
        }

        return MitarbeiterName(person);
    }

    private string AktuellerMonat()
    {
        var kultur = CultureInfo.GetCultureInfo("de-DE");
        return DateTime.Today.ToString("MMMM yyyy", kultur);
    }

    private void AuftragOeffnen(Auftrag auftrag)
    {
        ausgewaehlterAuftrag = auftrag;
    }

    private void AuftragSchliessen()
    {
        ausgewaehlterAuftrag = null;
    }

    private void ArbeitszeitPopupOeffnen()
    {
        neueArbeitszeit = new Arbeitszeit
        {
            MitarbeiterId = ausgewaehlterMitarbeiterId,
            Datum = DateTime.Today,
            Beginn = new TimeOnly(8, 0),
            Ende = new TimeOnly(16, 0)
        };

        arbeitszeitFehler = string.Empty;
        arbeitszeitPopupSichtbar = true;
    }

    private void ArbeitszeitPopupSchliessen()
    {
        arbeitszeitPopupSichtbar = false;
        arbeitszeitFehler = string.Empty;
        neueArbeitszeit = new Arbeitszeit();
    }

    private async Task ArbeitszeitSpeichern()
    {
        arbeitszeitFehler = ArbeitszeitService.Validierungsfehler(neueArbeitszeit);

        if (arbeitszeitFehler != string.Empty)
        {
            return;
        }

        await ArbeitszeitService.AddAsync(neueArbeitszeit);
        arbeitszeiten = await ArbeitszeitService.GetAllAsync();
        ArbeitszeitPopupSchliessen();
    }

    private string MitarbeiterName(Mitarbeiter? person)
    {
        if (person == null)
        {
            return "Unbekannter Mitarbeiter";
        }

        return person.Vorname + " " + person.Nachname;
    }

    private string MitarbeiterNamen(Auftrag auftrag)
    {
        var namen = string.Empty;

        foreach (var person in auftrag.Mitarbeiter)
        {
            if (namen != string.Empty)
            {
                namen += ", ";
            }

            namen += MitarbeiterName(person);
        }

        return namen == string.Empty ? "Keine" : namen;
    }
}
