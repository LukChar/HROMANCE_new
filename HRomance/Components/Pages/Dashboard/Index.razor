@page "/dashboard"
@rendermode InteractiveServer

@using HRomance.Models
@using HRomance.Services

@inject MitarbeiterService MitarbeiterService
@inject KundeService KundeService
@inject AuftragService AuftragService

<PageTitle>Dashboard</PageTitle>

<h3>Dashboard</h3>

<div class="row">

    <div class="col-md-4 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <h5>Mitarbeiter</h5>
                <h2>@anzahlMitarbeiter</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <h5>Verfügbare Mitarbeiter</h5>
                <h2>@verfuegbareMitarbeiter</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <h5>Kunden</h5>
                <h2>@anzahlKunden</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <h5>Aufträge</h5>
                <h2>@anzahlAuftraege</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <h5>Offene Aufträge</h5>
                <h2>@offeneAuftraege</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <h5>Besetzte Aufträge</h5>
                <h2>@besetzteAuftraege</h2>
            </div>
        </div>
    </div>

</div>

@code {

    private int anzahlMitarbeiter;
    private int verfuegbareMitarbeiter;
    private int anzahlKunden;
    private int anzahlAuftraege;
    private int offeneAuftraege;
    private int besetzteAuftraege;

    protected override async Task OnInitializedAsync()
    {
        var mitarbeiter = await MitarbeiterService.GetAllAsync();
        var kunden = await KundeService.GetAllAsync();
        var auftraege = await AuftragService.GetAllAsync();

        anzahlMitarbeiter = mitarbeiter.Count;
        verfuegbareMitarbeiter = mitarbeiter.Count(m => m.Verfuegbar);

        anzahlKunden = kunden.Count;

        anzahlAuftraege = auftraege.Count;
        offeneAuftraege = auftraege.Count(a => !a.Besetzt);
        besetzteAuftraege = auftraege.Count(a => a.Besetzt);
    }

}