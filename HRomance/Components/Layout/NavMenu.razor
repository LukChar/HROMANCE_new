@implements IDisposable

@inject NavigationManager NavigationManager

<div class="navigation-header">
    <a class="navbar-brand" href="/dashboard">
        <span>HR</span>
        <strong>HRomance</strong>
    </a>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <AuthorizeView>
            <Authorized>
                <div class="nav-section">MEIN BEREICH</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/dashboard">Dashboard</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/kalender">Kalender</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/antraege">Anträge</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Admin,Disponent">
            <Authorized>
                <div class="nav-section administration-section">VERWALTUNG</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/mitarbeiter">Mitarbeiter</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/kunden">Kunden</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/auftraege">Aufträge</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/matching">Matching</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/disposition">Disposition</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="account-area">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="Account/Manage">
                            <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span>
                            @context.User.Identity?.Name
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />

                            <button type="submit" class="nav-link">
                                <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span>
                                Logout
                            </button>
                        </form>
                    </div>
                </div>
            </Authorized>

            <NotAuthorized>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span>
                        Anmelden
                    </NavLink>
                </div>

            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

@code {

    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

}
